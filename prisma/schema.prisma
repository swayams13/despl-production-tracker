// DESPL Production Tracker — data model
// See docs/BUILD-SPEC-v2.md (what/why) and CLAUDE.md (invariants).
//
// ─────────────────────────────────────────────────────────────────────────
// DESIGN NOTES — read before changing anything here
//
// 1. TENANCY. Every business table carries `tenant_id` and is protected by
//    Postgres RLS keyed on current_setting('app.tenant_id'). One database,
//    one deploy, isolated rows. Adding this later would touch every query.
//
// 2. CLIENT SCOPING is a SECOND, independent boundary. A `User` with a
//    non-null `client_id` is an external client user and may only ever see
//    that client's work, via ProgressSnapshot — never live tables.
//
// 3. PROCESS TEMPLATES are per product family and versioned. A Job pins a
//    ProcessTemplateVersion at creation, then materialises editable
//    JobProcess rows. "This client skips PWHT and wants 8 nozzles" is a
//    data operation, never a migration.
//
// 4. ENUM POLICY. Postgres enums are used ONLY for closed state machines the
//    code branches on. Open vocabularies that grow with product families or
//    clients (component types, operations, NDT methods, drawing types, delay
//    categories, QCP codes) are tenant-scoped reference TABLES. Proof this
//    matters: the real QCP DESPL-320 uses PAUT, TOFD, MPT and LPT — none of
//    which existed in the old 6-value TestType enum.
//
// 5. SERVER CLOCK ONLY. Fields marked so below are set by the service layer
//    from the DB clock and must never appear in a request DTO (invariant #1).
//
// DELIBERATELY DEFERRED (all purely additive — new tables, no changes to
// existing ones, so adding them in week 3 costs nothing):
//   · master BOM catalog — PRD FR-B0/B1
//   · CustomFieldDef/Value, DocumentRequirementTemplate — per-client variance
// ─────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  // Application runtime: a non-owner role, so tenant RLS and the append-only
  // audit REVOKE actually apply to every query the app makes.
  url       = env("DATABASE_URL")
  // Migrations and seeding: the table owner, which RLS does not constrain.
  directUrl = env("DIRECT_URL")
}

// ── Enums: closed state machines only (see design note 4) ───────────────

/// UI appearance preference (D27). A closed set the code branches on, so it
/// is an enum and not a reference table (design note 4).
enum ThemePreference {
  SYSTEM
  LIGHT
  DARK
}

enum JobPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum JobStatus {
  ACTIVE
  ON_HOLD
  COMPLETE
  CANCELLED
}

enum ProcessEdgeType {
  FINISH_TO_START
  START_TO_START_WITH_OVERLAP
}

enum ScheduleMode {
  FORWARD
  BACKWARD
  OVERRIDE
}

enum ScheduleFeasibility {
  FEASIBLE
  TIGHT
  INFEASIBLE
}

enum ProcessPlanStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  COMPLETE
  ON_HOLD
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// BomRevision (Phase 4, B3): DRAFT is unused by anything in this dispatch —
/// the backfill script only ever creates RELEASED rows (invariant #9: a new
/// revision is a new row, never an edit). DRAFT exists for the later BOM
/// authoring dispatch, which will create/edit a revision before releasing it.
enum BomRevisionStatus {
  DRAFT
  RELEASED
}

/// B5, Phase 4: replaces ProcurementStatus/MaterialReceivedStatus — a
/// ProcurementEvent's `type` IS the status; there is no separate status enum
/// to keep in sync with the event log.
enum ProcurementEventType {
  INDENT_RAISED
  INDENT_APPROVED
  PO_PLACED
  RECEIPT
}

/// B6, Phase 4: StockTxn's kind. Receipt itself is NOT a txn type — it's a
/// `StockLot` creation (see StockLot's doc comment) — so this enum only ever
/// covers what happens to stock AFTER it lands on a lot.
enum StockTxnType {
  ISSUE
  RETURN
  SCRAP
}

enum PmiResult {
  NA
  PENDING
  ACCEPT
  REJECT
}

enum Sourcing {
  IN_HOUSE
  OUTSOURCE
  NA
}

enum OperationStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  COMPLETE
}

enum TestResult {
  PENDING
  ACCEPT
  REJECT
}

enum QcpItemKind {
  SECTION
  CHECKPOINT
}

enum QcpExecutionResult {
  PENDING
  ACCEPTED
  REJECTED
  NA
}

enum DrawingStatus {
  DRAFT
  SUBMITTED
  APPROVED
  RELEASED
  /// B9, Phase 4: a prior RELEASED revision flips here when a new revision
  /// is issued — never deleted, still queryable (invariant #9/#6).
  SUPERSEDED
}

enum DelayReviewStatus {
  PENDING
  ACKNOWLEDGED
  DISPUTED
}

enum NcrDisposition {
  USE_AS_IS
  REPAIR
  REWORK
  SCRAP
  CONCESSION
}

enum NcrStatus {
  OPEN
  DISPOSITIONED
  REWORK_IN_PROGRESS
  CLOSED
}

enum ProcessEvidenceKind {
  MDR_COMPILED
  PACKING_DONE
  DISPATCH_RECORDED
}

enum SnapshotCadence {
  LIVE
  DAILY
  WEEKLY
}

// ── Tenancy, identity, access ───────────────────────────────────────────

/// A tenant. DESPL today; sibling Vedanta Group companies later.
model Organization {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  clients                      Client[]
  users                        User[]
  roles                        Role[]
  departments                  Department[]
  productFamilies              ProductFamily[]
  processTemplates             ProcessTemplate[]
  jobs                         Job[]
  componentTypes               ComponentTypeRef[]
  equipmentTypes               EquipmentTypeRef[]
  workOrderStages              WorkOrderStage[]
  operations                   OperationRef[]
  operationRefSeqs             OperationRefFamilySeq[]
  testTypes                    TestTypeRef[]
  drawingTypes                 DrawingTypeRef[]
  delayCategories              DelayCategoryRef[]
  qcpCodes                     QcpCodeRef[]
  routeTemplates               RouteTemplate[]
  calendars                    WorkCalendar[]
  snapshots                    ProgressSnapshot[]
  notifications                Notification[]
  welders                      Welder[]
  assemblyTemplates            AssemblyTemplate[]
  // AUD-001 tenant-grain RLS backstop: back-relations for the 28 denormalized
  // tenant_id columns added alongside H1's job_id columns (see
  // prisma/migrations/20260909100000_aud001_tenant_id_backstop_add_column).
  units                        Unit[]
  bomRevisions                 BomRevision[]
  bomItems                     BomItem[]
  components                   Component[]
  jobProcessEdges              JobProcessEdge[]
  processPlans                 ProcessPlan[]
  weldJointWelders             WeldJointWelder[]
  ndtResults                   NdtResult[]
  drawingRevisions             DrawingRevision[]
  dispatchBatchUnits           DispatchBatchUnit[]
  inspectionParties            InspectionParty[]
  qcpItems                     QcpItem[]
  componentOperations          ComponentOperation[]
  componentOperationRejections ComponentOperationRejection[]
  paintRecords                 PaintRecord[]
  dftReadings                  DftReading[]
  assemblySteps                AssemblyStep[]
  assemblyStepRejections       AssemblyStepRejection[]
  ncrs                         Ncr[]
  qcpExecutions                QcpExecution[]
  qcpItemProcesses             QcpItemProcess[]
  qcpItemPartyCodes            QcpItemPartyCode[]
  delayReasons                 DelayReason[]
  stockLots                    StockLot[]
  stockTxns                    StockTxn[]
  procurementEvents            ProcurementEvent[]
  materialIdentifications      MaterialIdentification[]
  itemTests                    ItemTest[]
  // AUD-080: back-relations for the tenant_id columns added to the nine
  // job_id-carrying tables H1/AUD-001 omitted (see
  // prisma/migrations/20260909140000_aud080_tenant_id_add_column).
  equipments                   Equipment[]
  packages                     Package[]
  jobProcesses                 JobProcess[]
  scheduleRuns                 ScheduleRun[]
  weldJoints                   WeldJoint[]
  weldLogs                     WeldLog[]
  assemblyDrawings             AssemblyDrawing[]
  dispatchBatches              DispatchBatch[]
  qcpTemplates                 QcpTemplate[]

  @@map("organizations")
}

/// A customer of the tenant. NOT a tenant — clients live inside an org.
model Client {
  id       Int     @id @default(autoincrement())
  tenantId Int     @map("tenant_id")
  name     String
  code     String?

  tenant           Organization            @relation(fields: [tenantId], references: [id])
  jobs             Job[]
  users            User[]
  visibilityPolicy ClientVisibilityPolicy?

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("clients")
}

model User {
  id                 Int             @id @default(autoincrement())
  tenantId           Int             @map("tenant_id")
  /// Non-null => external client user. Scoped to this client, snapshots only.
  clientId           Int?            @map("client_id")
  email              String
  /// Login handle distinct from email (personal dashboards v1). Backfilled
  /// from the email local-part for existing rows. Tenant-scoped, not
  /// globally unique — matches `email`'s own scoping (design note: this app
  /// is architected multi-tenant even though only one org exists today; see
  /// resolveTenantForLogin). A plain global @unique would be the one field
  /// on this model that can collide across tenants.
  username           String          @map("username")
  passwordHash       String          @map("password_hash")
  name               String
  /// Tenant-scoped unique, matching Welder.employeeCode's own scoping.
  /// Nullable: Postgres allows multiple NULLs under a unique constraint, so
  /// existing rows with no employee code need no backfill.
  employeeCode       String?         @map("employee_code")
  active             Boolean         @default(true)
  /// New accounts must change their password on first login. Existing rows
  /// are backfilled to false in the migration (they already have working
  /// passwords) — only the Prisma default is true, for rows created after.
  mustChangePassword Boolean         @default(true) @map("must_change_password")
  /// Bumped on every `changeOwnPassword` call. `SessionPayload.sessionVersion`
  /// is stamped into the JWT at issuance; `getActor()` compares the two on
  /// every request and treats a mismatch as "not signed in" — this is how a
  /// password change invalidates every OTHER previously-issued token without
  /// a session table (personal dashboards v1, Task 1.3).
  sessionVersion     Int             @default(0) @map("session_version")
  createdAt          DateTime        @default(now()) @map("created_at")
  /// Stamped by `login()` on every successful sign-in (server clock only,
  /// invariant #1). Null = never logged in (seeded/imported, not yet used
  /// their credentials) — the /admin Employees table (SPEC §7.3) renders
  /// that as "Never", not a fabricated date.
  lastLoginAt        DateTime?       @map("last_login_at")
  /// UI appearance preference (D27, session R1 task 6). Per USER, not per
  /// browser — CLAUDE.md hard-bans localStorage for app state. SYSTEM defers
  /// to the OS's prefers-color-scheme; server-side rendering resolves it to
  /// dark and a tiny inline script corrects it before first paint.
  themePreference    ThemePreference @default(SYSTEM) @map("theme_preference")
  /// Outdoor (high-contrast shop-floor) palette on/off. Deliberately a
  /// SEPARATE column from themePreference even though today's single control
  /// presents them as one four-step cycle — the data model then survives a
  /// later UI that splits them back into two controls (D25).
  outdoorMode        Boolean         @default(false) @map("outdoor_mode")

  tenant                       Organization                  @relation(fields: [tenantId], references: [id])
  client                       Client?                       @relation(fields: [clientId], references: [id])
  roles                        UserRole[]
  departments                  UserDepartment[]
  assignedPlans                ProcessPlan[]
  performedComponentOperations ComponentOperation[]
  performedAssemblySteps       AssemblyStep[]
  procurementEvents            ProcurementEvent[]
  stockTxns                    StockTxn[]
  createdScheduleRuns          ScheduleRun[]
  submittedProcessPlans        ProcessPlan[]                 @relation("ProcessPlanSubmittedBy")
  verifiedProcessPlans         ProcessPlan[]                 @relation("ProcessPlanVerifiedBy")
  submittedComponentOps        ComponentOperation[]          @relation("ComponentOperationSubmittedBy")
  verifiedComponentOps         ComponentOperation[]          @relation("ComponentOperationVerifiedBy")
  rejectedComponentOps         ComponentOperationRejection[]
  loggedWeldJoints             WeldJoint[]
  loggedWeldLogs               WeldLog[]
  submittedAssemblySteps       AssemblyStep[]                @relation("AssemblyStepSubmittedBy")
  verifiedAssemblySteps        AssemblyStep[]                @relation("AssemblyStepVerifiedBy")
  rejectedAssemblySteps        AssemblyStepRejection[]
  clearedQcpExecutions         QcpExecution[]                @relation("QcpExecutionClearedBy")
  waiverApprovedQcpExecutions  QcpExecution[]                @relation("QcpExecutionWaiverApprovedBy")
  filedDelayReasons            DelayReason[]                 @relation("DelayReasonFiledBy")
  reviewedDelayReasons         DelayReason[]                 @relation("DelayReasonReviewedBy")
  publishedSnapshots           ProgressSnapshot[]            @relation("ProgressSnapshotPublishedBy")
  verifiedSnapshots            ProgressSnapshot[]            @relation("ProgressSnapshotVerifiedBy")
  createdBomRevisions          BomRevision[]
  recordedNdtResults           NdtResult[]
  publishedTemplateVersions    ProcessTemplateVersion[]
  ncrsDispositioned            Ncr[]                         @relation("NcrDispositionedBy")
  ncrsReworkOwned              Ncr[]                         @relation("NcrReworkOwner")
  ncrsClosed                   Ncr[]                         @relation("NcrClosedBy")
  recordedDftReadings          DftReading[]
  dispatchBatchesApproved      DispatchBatch[]               @relation("DispatchBatchReleaseApprovedBy")
  createdPackages              Package[]

  @@unique([tenantId, email])
  @@unique([tenantId, username])
  @@unique([tenantId, employeeCode])
  @@index([tenantId])
  @@index([clientId])
  @@map("users")
}

model Role {
  id       Int    @id @default(autoincrement())
  tenantId Int    @map("tenant_id")
  /// ADMIN | MANAGEMENT | PRODUCTION_HEAD | SUPERVISOR | QC | CLIENT_VIEWER
  code     String
  name     String

  tenant Organization @relation(fields: [tenantId], references: [id])
  users  UserRole[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("roles")
}

model UserRole {
  userId Int @map("user_id")
  roleId Int @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Department {
  id           Int     @id @default(autoincrement())
  tenantId     Int     @map("tenant_id")
  code         String
  name         String
  scope        String?
  /// Whether this is a desk-side department reachable at /command/[dept]
  /// (personal dashboards v1) vs. a floor department (redirects to
  /// /workspace instead). Replaces command-center.read.ts's old hardcoded
  /// office/floor code lists — tenant-authored data, not a code branch, per
  /// docs/ADR-product-family-agnostic-platform-v1.md's "DESPL-320 rule".
  isOfficeDept Boolean @default(false) @map("is_office_dept")

  tenant                Organization           @relation(fields: [tenantId], references: [id])
  users                 UserDepartment[]
  templateProcesses     TemplateProcess[]
  jobProcesses          JobProcess[]
  processPlans          ProcessPlan[]
  operations            OperationRef[]
  welders               Welder[]
  assemblyTemplateSteps AssemblyTemplateStep[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("departments")
}

/// Which departments a supervisor is scoped to (DepartmentScopeGuard).
model UserDepartment {
  userId       Int @map("user_id")
  departmentId Int @map("department_id")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id])

  @@id([userId, departmentId])
  @@index([departmentId])
  @@map("user_departments")
}

// ── Reference vocabularies (see design note 4) ──────────────────────────

model ComponentTypeRef {
  id       Int     @id @default(autoincrement())
  tenantId Int     @map("tenant_id")
  code     String
  name     String
  active   Boolean @default(true)

  tenant         Organization    @relation(fields: [tenantId], references: [id])
  routeTemplates RouteTemplate[]
  components     Component[]
  bomItems       BomItem[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("component_type_refs")
}

/// Equipment catalog. The "type" of thing being built (HP Air Receiver,
/// 2000 L), distinct from ProductFamily (the process route it follows) and
/// from Equipment (one job's actual block). Carries tenant_id, so it is a
/// tenant-root table and has its own RLS policy — see the migration.
model EquipmentTypeRef {
  id                Int     @id @default(autoincrement())
  tenantId          Int     @map("tenant_id")
  familyId          Int     @map("family_id")
  /// Stable short code, e.g. HP-AIR-RCVR-2000
  code              String
  name              String
  defaultDesignCode String? @map("default_design_code")
  /// Family-shaped design defaults, copied into Job.specs at intake.
  defaultSpecs      Json?   @map("default_specs")
  active            Boolean @default(true)

  tenant     Organization  @relation(fields: [tenantId], references: [id])
  family     ProductFamily @relation(fields: [familyId], references: [id])
  equipments Equipment[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([familyId])
  @@map("equipment_type_refs")
}

/// Canonical manufacturing operation. Grows per product family
/// (e.g. EXPANSION for heat-exchanger tubes).
model OperationRef {
  id                  Int     @id @default(autoincrement())
  tenantId            Int     @map("tenant_id")
  code                String
  name                String
  defaultDepartmentId Int?    @map("default_department_id")
  /// Column name in DESPL's live tracker CSVs, where one exists.
  sourceColumn        String? @map("source_column")
  active              Boolean @default(true)
  /// B6: declarative replacement for component.service.ts's old
  /// `operationCode === "PAINTING"` branch. Tenant-authored (seeded from
  /// `seed/component-routes.json`'s `canonicalOperations.PAINTING`), not a
  /// code literal — verifyComponentOperation gates on this flag instead of a
  /// hardcoded op code.
  requiresDftGate     Boolean @default(false) @map("requires_dft_gate")

  tenant            Organization            @relation(fields: [tenantId], references: [id])
  defaultDepartment Department?             @relation(fields: [defaultDepartmentId], references: [id])
  routeSteps        RouteStep[]
  componentOps      ComponentOperation[]
  familySeqMappings OperationRefFamilySeq[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([defaultDepartmentId])
  @@map("operation_refs")
}

/// Gate 3 fix: `OperationRef.leadTimeProcessSeq` used to be one tenant-wide
/// number per canonical operation, authored only for PRESSURE_VESSEL's
/// 36-process spine — a second family's `JobProcess.code` numbering would
/// silently match through it (the join is by bare value, no FK). This table
/// makes the mapping family-scoped: the same physical operation (e.g.
/// CUTTING) can roll up into a different lead-time-process number per
/// family, and a family with no row here fails open (SEAM, same convention
/// as `_shared.ts`'s non-numeric-code case) instead of silently borrowing
/// another family's number.
model OperationRefFamilySeq {
  id                 Int @id @default(autoincrement())
  tenantId           Int @map("tenant_id")
  operationRefId     Int @map("operation_ref_id")
  familyId           Int @map("family_id")
  /// Which of the family's own template processes (`JobProcess.code`, as a
  /// number) this operation rolls up into.
  leadTimeProcessSeq Int @map("lead_time_process_seq")

  tenant       Organization  @relation(fields: [tenantId], references: [id])
  operationRef OperationRef  @relation(fields: [operationRefId], references: [id], onDelete: Cascade)
  family       ProductFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([operationRefId, familyId])
  @@index([tenantId])
  /// _shared.ts's numeric-join gates (loadMappedOps/assertNoOpenNcr) filter
  /// by (familyId, leadTimeProcessSeq) on every submitProcess/verifyProcess
  /// call — the hot path S21 originally indexed on OperationRef itself.
  @@index([familyId, leadTimeProcessSeq])
  @@map("operation_ref_family_seqs")
}

/// NDT / test methods. RT, UT, DP, HT, PNEUMATIC, VACUUM — plus PAUT, TOFD,
/// MPT, LPT which the real QCP uses and the old enum could not express.
model TestTypeRef {
  id       Int     @id @default(autoincrement())
  tenantId Int     @map("tenant_id")
  code     String
  name     String
  active   Boolean @default(true)

  tenant     Organization @relation(fields: [tenantId], references: [id])
  tests      ItemTest[]
  ndtResults NdtResult[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("test_type_refs")
}

model DrawingTypeRef {
  id       Int     @id @default(autoincrement())
  tenantId Int     @map("tenant_id")
  code     String
  name     String
  active   Boolean @default(true)

  tenant   Organization      @relation(fields: [tenantId], references: [id])
  drawings AssemblyDrawing[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("drawing_type_refs")
}

model DelayCategoryRef {
  id       Int     @id @default(autoincrement())
  tenantId Int     @map("tenant_id")
  code     String
  name     String
  active   Boolean @default(true)

  tenant                       Organization                  @relation(fields: [tenantId], references: [id])
  delayReasons                 DelayReason[]
  componentOperationRejections ComponentOperationRejection[]
  assemblyStepRejections       AssemblyStepRejection[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("delay_category_refs")
}

/// QCP inspection code AND its gating semantics. These three flags previously
/// lived only in seed/qcp-templates.json, which would have forced the
/// hold-point engine to hard-code them. C7 (what RW and R&A mean) is still
/// open with DESPL, so they must be editable without a deploy.
model QcpCodeRef {
  id               Int     @id @default(autoincrement())
  tenantId         Int     @map("tenant_id")
  code             String
  label            String
  blocksCompletion Boolean @default(false) @map("blocks_completion")
  requiresCall     Boolean @default(false) @map("requires_call")
  waivable         Boolean @default(false)

  tenant     Organization       @relation(fields: [tenantId], references: [id])
  partyCodes QcpItemPartyCode[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("qcp_code_refs")
}

// ── Calendar (C1: working vs calendar days — highest-impact open question) ─

model WorkCalendar {
  id          Int     @id @default(autoincrement())
  tenantId    Int     @map("tenant_id")
  code        String
  name        String
  /// ISO day numbers that are non-working. Default [7] = Sunday off.
  weekOffDays Int[]   @map("week_off_days")
  isDefault   Boolean @default(false) @map("is_default")

  tenant   Organization @relation(fields: [tenantId], references: [id])
  holidays Holiday[]
  jobs     Job[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("work_calendars")
}

model Holiday {
  id         Int      @id @default(autoincrement())
  calendarId Int      @map("calendar_id")
  date       DateTime @db.Date
  name       String

  calendar WorkCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@unique([calendarId, date])
  @@index([calendarId])
  @@map("holidays")
}

// ── Product families and versioned process templates (design note 3) ────

model ProductFamily {
  id       Int     @id @default(autoincrement())
  tenantId Int     @map("tenant_id")
  /// PRESSURE_VESSEL | HEAT_EXCHANGER | PIPE_SPOOL | PIPING_SYSTEM
  code     String
  name     String
  active   Boolean @default(true)

  tenant            Organization            @relation(fields: [tenantId], references: [id])
  templates         ProcessTemplate[]
  jobs              Job[]
  routes            RouteTemplate[]
  equipmentTypes    EquipmentTypeRef[]
  assemblyTemplates AssemblyTemplate[]
  workOrderStages   WorkOrderStage[]
  operationRefSeqs  OperationRefFamilySeq[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("product_families")
}

/// B7: display names for the 25-stage work-order reporting view
/// (`TemplateProcess.workOrderStages[]`'s target numbers), per family —
/// replaces the old hardcoded, family-agnostic `STAGE_NAMES` constant
/// (`src/lib/shared/stage-names.ts`, deleted). A family with no stage
/// crosswalk yet (workOrderStages always `[]`) simply has no rows here;
/// callers fall back to a plain "Stage N" label.
model WorkOrderStage {
  id       Int    @id @default(autoincrement())
  tenantId Int    @map("tenant_id")
  familyId Int    @map("family_id")
  stageNo  Int    @map("stage_no")
  name     String

  tenant Organization  @relation(fields: [tenantId], references: [id])
  family ProductFamily @relation(fields: [familyId], references: [id])

  @@unique([tenantId, familyId, stageNo])
  @@index([tenantId])
  @@index([familyId])
  @@map("work_order_stages")
}

model ProcessTemplate {
  id       Int    @id @default(autoincrement())
  tenantId Int    @map("tenant_id")
  familyId Int    @map("family_id")
  name     String

  tenant   Organization             @relation(fields: [tenantId], references: [id])
  family   ProductFamily            @relation(fields: [familyId], references: [id])
  versions ProcessTemplateVersion[]

  @@index([tenantId])
  @@index([familyId])
  @@map("process_templates")
}

model ProcessTemplateVersion {
  id          Int            @id @default(autoincrement())
  templateId  Int            @map("template_id")
  version     Int
  status      TemplateStatus @default(DRAFT)
  publishedAt DateTime?      @map("published_at")
  publishedBy Int?           @map("published_by")
  notes       String?
  /// Optimistic-lock token for the draft editor. Nullable because existing
  /// rows predate it; a null reads as "never edited since the column landed"
  /// and the service treats a null-vs-null comparison as a match.
  updatedAt   DateTime?      @updatedAt @map("updated_at")

  template  ProcessTemplate   @relation(fields: [templateId], references: [id])
  processes TemplateProcess[]
  edges     TemplateEdge[]
  jobs      Job[]
  publisher User?             @relation(fields: [publishedBy], references: [id])

  @@unique([templateId, version])
  @@index([templateId])
  @@map("process_template_versions")
}

/// One process in a template version. For PRESSURE_VESSEL v1 these are the
/// 36 rows of DESPL's Lead Time table.
model TemplateProcess {
  id                      Int                  @id @default(autoincrement())
  versionId               Int                  @map("version_id")
  seq                     Int
  code                    String
  name                    String
  mainActivities          String?              @map("main_activities")
  /// Nullable + `provisional` together, deliberately: a family with a process
  /// ROUTE but no confirmed durations (e.g. PIPE_SPOOL, derived from a QAP's
  /// activity sequence, not a lead-time document) can exist without inventing
  /// numbers. `lib/schedule/` MUST refuse to compute a plan — return a clear
  /// "SCHEDULE_DATA_MISSING"-style refusal, never a 0-day or guessed date —
  /// for any process where `provisional` is true or a duration is null.
  durationMinDays         Int?                 @map("duration_min_days")
  durationMaxDays         Int?                 @map("duration_max_days")
  cumulativePrinted       String?              @map("cumulative_printed")
  defaultDepartmentId     Int                  @map("default_department_id")
  /// Crosswalk to the 25-stage work-order reporting view. Pressure-Vessel-
  /// specific; empty for families with no equivalent reporting view.
  workOrderStages         Int[]                @map("work_order_stages")
  envelopeFinishByMinDays Int?                 @map("envelope_finish_by_min_days")
  envelopeFinishByMaxDays Int?                 @map("envelope_finish_by_max_days")
  envelopeStartByMinDays  Int?                 @map("envelope_start_by_min_days")
  envelopeStartByMaxDays  Int?                 @map("envelope_start_by_max_days")
  /// Conditional processes (e.g. PWHT) can be excluded per job.
  optional                Boolean              @default(false)
  /// True = process/sequence is real (sourced from a QAP or lead-time doc),
  /// but duration is not confirmed by DESPL. Distinct from `optional`.
  provisional             Boolean              @default(false)
  evidenceKind            ProcessEvidenceKind? @map("evidence_kind")

  version            ProcessTemplateVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  defaultDepartment  Department             @relation(fields: [defaultDepartmentId], references: [id])
  edgesAsProcess     TemplateEdge[]         @relation("TemplateEdgeProcess")
  edgesAsPredecessor TemplateEdge[]         @relation("TemplateEdgePredecessor")
  jobProcesses       JobProcess[]

  @@unique([versionId, code])
  @@index([versionId])
  @@index([defaultDepartmentId])
  @@map("template_processes")
}

/// lagDays < 0 means legitimate concurrent work (START_TO_START_WITH_OVERLAP),
/// not a data error. It relaxes the SCHEDULE only — never gating (invariant #11).
model TemplateEdge {
  id            Int             @id @default(autoincrement())
  versionId     Int             @map("version_id")
  processId     Int             @map("process_id")
  predecessorId Int             @map("predecessor_id")
  type          ProcessEdgeType
  lagDays       Int             @map("lag_days")

  version     ProcessTemplateVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  process     TemplateProcess        @relation("TemplateEdgeProcess", fields: [processId], references: [id], onDelete: Cascade)
  predecessor TemplateProcess        @relation("TemplateEdgePredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)

  @@unique([processId, predecessorId])
  @@index([versionId])
  @@index([predecessorId])
  @@map("template_edges")
}

// ── Job / Equipment / Unit ──────────────────────────────────────────────

/// Kept as "Job" (not renamed to Project) — it matches DESPL's own vocabulary
/// and every existing doc. `clientOrderNo` vs `jobNumber` resolves C5: both
/// live CSVs carry Work Order DE0455-01 while the jobs are DE0463/DE0467.
model Job {
  id                        Int         @id @default(autoincrement())
  tenantId                  Int         @map("tenant_id")
  /// Opaque id for client-facing URLs — sequential ids leak order volume.
  publicId                  String      @unique @map("public_id")
  clientId                  Int         @map("client_id")
  familyId                  Int         @map("family_id")
  templateVersionId         Int         @map("template_version_id")
  /// Nullable — a family with no authored assembly sequence yet
  /// (HEAT_EXCHANGER, PIPING_SYSTEM as of Phase 2) must still create jobs.
  /// Pinned at intake exactly like templateVersionId once an intake UI exists
  /// for it; for now set directly (see A2's materialisation script).
  assemblyTemplateVersionId Int?        @map("assembly_template_version_id")
  calendarId                Int?        @map("calendar_id")
  jobNumber                 String      @map("job_number")
  /// The client's own order number, when it differs from ours (C5).
  clientOrderNo             String?     @map("client_order_no")
  projectName               String?     @map("project_name")
  poRef                     String?     @map("po_ref")
  designCode                String?     @map("design_code")
  orderDate                 DateTime?   @map("order_date")
  /// The contractual date given to the client. BACKWARD scheduling anchors on
  /// this by default, and every overdue / KPI / forecast-vs-due calculation
  /// measures against it. Renamed from `deliveryDate` (22 Aug 2026): the CSV
  /// import was writing a *dispatch* date into a field the scheduler read as a
  /// *required delivery* date, conflating two different commitments.
  committedDeliveryDate     DateTime?   @map("committed_delivery_date")
  /// DESPL's own internal target, normally earlier than the committed date and
  /// carrying their buffer. Never shown to a client user.
  targetDispatchDate        DateTime?   @map("target_dispatch_date")
  /// Family-shaped design configuration (design pressure, MDMT, MOC, …).
  /// Display and reference data ONLY. Nothing in lib/schedule/ or the gating
  /// path may read it — the moment a schedule depends on a free-shaped blob,
  /// refusals stop being explainable (invariant #12).
  specs                     Json?
  priority                  JobPriority @default(NORMAL)
  status                    JobStatus   @default(ACTIVE)
  remarks                   String?

  tenant                       Organization                  @relation(fields: [tenantId], references: [id])
  client                       Client                        @relation(fields: [clientId], references: [id])
  family                       ProductFamily                 @relation(fields: [familyId], references: [id])
  templateVersion              ProcessTemplateVersion        @relation(fields: [templateVersionId], references: [id])
  assemblyTemplateVersion      AssemblyTemplateVersion?      @relation(fields: [assemblyTemplateVersionId], references: [id])
  calendar                     WorkCalendar?                 @relation(fields: [calendarId], references: [id])
  equipments                   Equipment[]
  processes                    JobProcess[]
  scheduleRuns                 ScheduleRun[]
  qcpTemplates                 QcpTemplate[]
  drawings                     AssemblyDrawing[]
  snapshots                    ProgressSnapshot[]
  dispatchBatches              DispatchBatch[]
  packages                     Package[]
  weldJoints                   WeldJoint[]
  weldLogs                     WeldLog[]
  // H1 job-level RLS backstop: back-relations for the 28 denormalized job_id
  // columns (see docs/superpowers/plans/2026-09-05-h1-job-level-rls-backstop.md).
  units                        Unit[]
  bomRevisions                 BomRevision[]
  bomItems                     BomItem[]
  components                   Component[]
  jobProcessEdges              JobProcessEdge[]
  processPlans                 ProcessPlan[]
  weldJointWelders             WeldJointWelder[]
  ndtResults                   NdtResult[]
  drawingRevisions             DrawingRevision[]
  dispatchBatchUnits           DispatchBatchUnit[]
  inspectionParties            InspectionParty[]
  qcpItems                     QcpItem[]
  componentOperations          ComponentOperation[]
  componentOperationRejections ComponentOperationRejection[]
  paintRecords                 PaintRecord[]
  dftReadings                  DftReading[]
  assemblySteps                AssemblyStep[]
  assemblyStepRejections       AssemblyStepRejection[]
  ncrs                         Ncr[]
  qcpExecutions                QcpExecution[]
  qcpItemProcesses             QcpItemProcess[]
  qcpItemPartyCodes            QcpItemPartyCode[]
  delayReasons                 DelayReason[]
  stockLots                    StockLot[]
  stockTxns                    StockTxn[]
  procurementEvents            ProcurementEvent[]
  materialIdentifications      MaterialIdentification[]
  itemTests                    ItemTest[]

  @@unique([tenantId, jobNumber])
  @@index([tenantId])
  @@index([clientId])
  @@index([familyId])
  @@index([templateVersionId])
  @@index([assemblyTemplateVersionId])
  @@index([calendarId])
  @@map("jobs")
}

model Equipment {
  id              Int     @id @default(autoincrement())
  jobId           Int     @map("job_id")
  name            String
  blockNo         Int?    @map("block_no")
  remarks         String?
  /// Nullable: the seeded DE0463/DE0467 blocks came from CSV with free-text
  /// labels and no catalog entry. Backfilling them would mean inventing
  /// catalog rows, so they stay unlinked.
  equipmentTypeId Int?    @map("equipment_type_id")
  /// AUD-080: 0 is a placeholder Prisma needs to treat this field as
  /// optional in create() input. The BEFORE INSERT DB trigger
  /// (aud001_derive_tenant_id, reused as-is by AUD-080) always overwrites it from job_id before
  /// any constraint check runs — 0 is never actually persisted.
  tenantId        Int     @default(0) @map("tenant_id")

  job           Job                @relation(fields: [jobId], references: [id])
  tenant        Organization       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  equipmentType EquipmentTypeRef?  @relation(fields: [equipmentTypeId], references: [id])
  units         Unit[]
  bomItems      BomItem[]
  bomRevisions  BomRevision[]
  components    Component[]
  scheduleRuns  ScheduleRun[]
  snapshots     ProgressSnapshot[]

  @@index([jobId])
  @@index([equipmentTypeId])
  @@index([tenantId])
  @@map("equipments")
}

/// An individual serial (320SR01…). DE0463 is 40 units of one equipment.
model Unit {
  id          Int      @id @default(autoincrement())
  equipmentId Int      @map("equipment_id")
  serialNo    String   @map("serial_no")
  packageId   Int?     @map("package_id")
  /// H1 job-level RLS backstop: denormalized from equipment.jobId. Nullable
  /// during migration only — backfilled by scripts/h1-backfill-job-ids.ts.
  jobId       Int      @map("job_id")
  /// AUD-001: 0 is a placeholder Prisma needs to treat this field as
  /// optional in create() input. The BEFORE INSERT DB trigger
  /// (aud001_derive_tenant_id) always overwrites it from job_id before
  /// any constraint check runs — 0 is never actually persisted.
  tenantId    Int      @default(0) @map("tenant_id")
  createdAt   DateTime @default(now()) @map("created_at")

  equipment          Equipment           @relation(fields: [equipmentId], references: [id])
  package            Package?            @relation(fields: [packageId], references: [id])
  job                Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tenant             Organization        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  qcpExecutions      QcpExecution[]
  processPlans       ProcessPlan[]
  components         Component[]
  snapshots          ProgressSnapshot[]
  weldJoints         WeldJoint[]
  assemblySteps      AssemblyStep[]
  dispatchBatchUnits DispatchBatchUnit[]

  @@unique([equipmentId, serialNo])
  @@index([equipmentId])
  @@index([packageId])
  @@index([jobId])
  @@index([tenantId])
  @@map("units")
}

/// D1 — a Unit belongs to at most one Package (simplest cardinality that
/// fits "packing list of contents by serial"). D2's DispatchBatchUnit is a
/// separate join because a dispatch batch groups units directly, not via
/// Package.
model Package {
  id                Int      @id @default(autoincrement())
  jobId             Int      @map("job_id")
  packageNo         String   @map("package_no")
  weightKg          Decimal? @map("weight_kg")
  lengthMm          Int?     @map("length_mm")
  widthMm           Int?     @map("width_mm")
  heightMm          Int?     @map("height_mm")
  preservationNotes String?  @map("preservation_notes")
  createdBy         Int      @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")
  /// AUD-080: 0 is a placeholder Prisma needs to treat this field as
  /// optional in create() input. The BEFORE INSERT DB trigger
  /// (aud001_derive_tenant_id, reused as-is by AUD-080) always overwrites it from job_id before
  /// any constraint check runs — 0 is never actually persisted.
  tenantId          Int      @default(0) @map("tenant_id")

  job           Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tenant        Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdByUser User         @relation(fields: [createdBy], references: [id])
  units         Unit[]

  @@unique([jobId, packageNo])
  @@index([jobId])
  @@index([tenantId])
  @@map("packages")
}

/// The job's own copy of the process spine, materialised from the pinned
/// template version and then editable. `included = false` = this client skips
/// it. `templateProcessId = null` = added for this job only.
model JobProcess {
  id                      Int     @id @default(autoincrement())
  jobId                   Int     @map("job_id")
  templateProcessId       Int?    @map("template_process_id")
  seq                     Int
  code                    String
  name                    String
  departmentId            Int     @map("department_id")
  /// Nullable + `provisional`: see TemplateProcess. A job pinned to a
  /// provisional template materialises provisional JobProcess rows too —
  /// `lib/schedule/` must refuse to plan around them, not guess.
  durationMinDays         Int?    @map("duration_min_days")
  durationMaxDays         Int?    @map("duration_max_days")
  envelopeFinishByMinDays Int?    @map("envelope_finish_by_min_days")
  envelopeFinishByMaxDays Int?    @map("envelope_finish_by_max_days")
  envelopeStartByMinDays  Int?    @map("envelope_start_by_min_days")
  envelopeStartByMaxDays  Int?    @map("envelope_start_by_max_days")
  workOrderStages         Int[]   @map("work_order_stages")
  included                Boolean @default(true)
  durationOverrideDays    Int?    @map("duration_override_days")
  overrideReason          String? @map("override_reason")
  provisional             Boolean @default(false)
  /// AUD-080: 0 is a placeholder Prisma needs to treat this field as
  /// optional in create() input. The BEFORE INSERT DB trigger
  /// (aud001_derive_tenant_id, reused as-is by AUD-080) always overwrites it from job_id before
  /// any constraint check runs — 0 is never actually persisted.
  tenantId                Int     @default(0) @map("tenant_id")

  job                Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tenant             Organization     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  templateProcess    TemplateProcess? @relation(fields: [templateProcessId], references: [id])
  department         Department       @relation(fields: [departmentId], references: [id])
  edgesAsProcess     JobProcessEdge[] @relation("JobEdgeProcess")
  edgesAsPredecessor JobProcessEdge[] @relation("JobEdgePredecessor")
  processPlans       ProcessPlan[]
  qcpItemLinks       QcpItemProcess[]

  @@unique([jobId, code])
  @@index([jobId])
  @@index([departmentId])
  @@index([templateProcessId])
  @@index([tenantId])
  @@map("job_processes")
}

model JobProcessEdge {
  id            Int             @id @default(autoincrement())
  processId     Int             @map("process_id")
  predecessorId Int             @map("predecessor_id")
  type          ProcessEdgeType
  lagDays       Int             @map("lag_days")
  /// H1 job-level RLS backstop: denormalized from process.jobId.
  jobId         Int             @map("job_id")
  /// AUD-001: 0 is a placeholder Prisma needs to treat this field as
  /// optional in create() input. The BEFORE INSERT DB trigger
  /// (aud001_derive_tenant_id) always overwrites it from job_id before
  /// any constraint check runs — 0 is never actually persisted.
  tenantId      Int             @default(0) @map("tenant_id")

  process     JobProcess   @relation("JobEdgeProcess", fields: [processId], references: [id], onDelete: Cascade)
  predecessor JobProcess   @relation("JobEdgePredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  job         Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tenant      Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([processId, predecessorId])
  @@index([predecessorId])
  @@index([jobId])
  @@index([tenantId])
  @@map("job_process_edges")
}

// ── Scheduling ──────────────────────────────────────────────────────────

/// AUD-034 — a job may have at most one CURRENT run, full stop, regardless of
/// equipmentId grain (a job-grain run and an equipment-grain run competing for
/// "current" was proven live: persistScheduleRun used to demote only the
/// matching (jobId, equipmentId) pair, so a job-grain generateSchedule call
/// followed by an equipment-grain applyDurationOverride call left both
/// isCurrent = true — double-counting every reader that assumes exactly one).
///
/// UNIQUENESS CONSTRAINT (DDL-only, not representable in Prisma schema DSL):
/// Enforced by a raw-SQL partial unique index in migration
/// 20260908130000_schedule_run_one_current_per_job:
///   CREATE UNIQUE INDEX schedule_runs_one_current_per_job ON schedule_runs (job_id) WHERE is_current;
/// This is intentionally NOT `(job_id, equipment_id)` or a COALESCE-guarded
/// variant of it — that shape only prevents two runs at the identical grain
/// from racing, not the job-grain-vs-equipment-grain case above. Application
/// code (_shared.ts's persistScheduleRun/getCurrentScheduleRun/
/// getCurrentScheduleRunsBatch) enforces the same invariant at the service
/// layer; this index is the DB-level backstop for any write that bypasses it.
model ScheduleRun {
  id                   Int                  @id @default(autoincrement())
  jobId                Int                  @map("job_id")
  equipmentId          Int?                 @map("equipment_id")
  version              Int
  mode                 ScheduleMode
  projectStartDate     DateTime             @map("project_start_date")
  requiredDeliveryDate DateTime?            @map("required_delivery_date")
  feasibility          ScheduleFeasibility?
  /// Days short when INFEASIBLE — surfaced at tender stage.
  shortfallDays        Int?                 @map("shortfall_days")
  isCurrent            Boolean              @default(false) @map("is_current")
  overrideReason       String?              @map("override_reason")
  createdBy            Int?                 @map("created_by")
  createdAt            DateTime             @default(now()) @map("created_at")
  /// AUD-080: 0 is a placeholder Prisma needs to treat this field as
  /// optional in create() input. The BEFORE INSERT DB trigger
  /// (aud001_derive_tenant_id, reused as-is by AUD-080) always overwrites it from job_id before
  /// any constraint check runs — 0 is never actually persisted.
  tenantId             Int                  @default(0) @map("tenant_id")

  job          Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tenant       Organization  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  equipment    Equipment?    @relation(fields: [equipmentId], references: [id])
  processPlans ProcessPlan[]
  creator      User?         @relation(fields: [createdBy], references: [id])

  @@unique([jobId, equipmentId, version])
  @@index([jobId])
  @@index([equipmentId])
  @@index([tenantId])
  @@map("schedule_runs")
}

/// `unitId` nullable closes the schedule↔execution grain gap: equipment-level
/// plans before Final Assembly, per-serial plans after it (BUILD-SPEC §0 #2).
///
/// UNIQUENESS CONSTRAINT (DDL-only, not representable in Prisma schema DSL):
/// Enforced by raw SQL in migration 20260827170000_actor_fks_and_partial_unique.
/// Two indexes jointly prevent duplicate rows:
/// 1. Partial unique on (schedule_run_id, job_process_id, unit_id) WHERE unit_id IS NOT NULL
/// 2. Partial unique on (schedule_run_id, job_process_id) WHERE unit_id IS NULL
/// This allows per-unit schedule expansion (multiple rows same scheduleRunId/jobProcessId with different unitId)
/// while preventing duplicate null-unitId rows (PostgreSQL treats NULL as distinct in regular indexes).
/// Do not let a future `prisma migrate dev` drift proposal recreate a plain/full unique index
/// under the "process_plans_schedule_run_id_job_process_id_unit_id_key" name — such a proposal
/// should be rejected as it would recreate the original bug (null duplicate rows).
model ProcessPlan {
  id                Int               @id @default(autoincrement())
  scheduleRunId     Int               @map("schedule_run_id")
  jobProcessId      Int               @map("job_process_id")
  unitId            Int?              @map("unit_id")
  baselineStart     DateTime?         @map("baseline_start")
  baselineFinish    DateTime?         @map("baseline_finish")
  plannedStart      DateTime?         @map("planned_start")
  plannedFinish     DateTime?         @map("planned_finish")
  /// SERVER CLOCK ONLY (invariant #1)
  actualStart       DateTime?         @map("actual_start")
  /// SERVER CLOCK ONLY (invariant #1)
  actualFinish      DateTime?         @map("actual_finish")
  status            ProcessPlanStatus @default(NOT_STARTED)
  submittedBy       Int?              @map("submitted_by")
  verifiedBy        Int?              @map("verified_by")
  ownerDepartmentId Int               @map("owner_department_id")
  /// NULL = unassigned, sits in the department pool (Task 1.2's concern).
  assigneeUserId    Int?              @map("assignee_user_id")
  /// H1 job-level RLS backstop: denormalized from jobProcess.jobId
  /// (cross-checked against scheduleRun.jobId at backfill time — see
  /// docs/superpowers/plans/2026-09-05-h1-job-level-rls-backstop.md's
  /// dual-path note).
  jobId             Int               @map("job_id")
  /// AUD-001: 0 is a placeholder Prisma needs to treat this field as
  /// optional in create() input. The BEFORE INSERT DB trigger
  /// (aud001_derive_tenant_id) always overwrites it from job_id before
  /// any constraint check runs — 0 is never actually persisted.
  tenantId          Int               @default(0) @map("tenant_id")

  scheduleRun     ScheduleRun   @relation(fields: [scheduleRunId], references: [id], onDelete: Cascade)
  jobProcess      JobProcess    @relation(fields: [jobProcessId], references: [id])
  unit            Unit?         @relation(fields: [unitId], references: [id])
  ownerDepartment Department    @relation(fields: [ownerDepartmentId], references: [id])
  assignee        User?         @relation(fields: [assigneeUserId], references: [id])
  submitter       User?         @relation("ProcessPlanSubmittedBy", fields: [submittedBy], references: [id])
  verifier        User?         @relation("ProcessPlanVerifiedBy", fields: [verifiedBy], references: [id])
  job             Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tenant          Organization  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  delayReasons    DelayReason[]

  @@index([scheduleRunId])
  @@index([jobProcessId])
  @@index([unitId])
  // drives every "due this week", notification and escalation query
  @@index([ownerDepartmentId, plannedFinish])
  @@index([status])
  @@index([assigneeUserId, status])
  @@index([jobId])
  @@index([tenantId])
  @@map("process_plans")
}

// ── BOM, components and traceability ────────────────────────────────────

/// One equipment can have many revisions over time (invariant #9's versioning
/// convention — same shape as TemplateVersion/AssemblyTemplateVersion: a new
/// revision is a new row, never an edit to a released one). Phase 4, B3: this
/// dispatch only ever creates the one auto-backfilled "Revision 1, RELEASED"
/// row per equipment (scripts/backfill-bom-revision.ts) — the write path for
/// authoring a new revision belongs to a later, separately-dispatched task.
model BomRevision {
  id          Int               @id @default(autoincrement())
  equipmentId Int               @map("equipment_id")
  revisionNo  Int               @map("revision_no")
  status      BomRevisionStatus @default(DRAFT)
  releasedAt  DateTime?         @map("released_at")
  createdBy   Int?              @map("created_by")
  /// H1 job-level RLS backstop: denormalized from equipment.jobId.
  jobId       Int               @map("job_id")
  /// AUD-001: 0 is a placeholder Prisma needs to treat this field as
  /// optional in create() input. The BEFORE INSERT DB trigger
  /// (aud001_derive_tenant_id) always overwrites it from job_id before
  /// any constraint check runs — 0 is never actually persisted.
  tenantId    Int               @default(0) @map("tenant_id")
  createdAt   DateTime          @default(now()) @map("created_at")

  equipment Equipment    @relation(fields: [equipmentId], references: [id])
  creator   User?        @relation(fields: [createdBy], references: [id])
  job       Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tenant    Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bomItems  BomItem[]

  @@unique([equipmentId, revisionNo])
  @@index([equipmentId])
  @@index([jobId])
  @@index([tenantId])
  @@map("bom_revisions")
}

model BomItem {
  id              Int      @id @default(autoincrement())
  equipmentId     Int      @map("equipment_id")
  itemNo          Int      @map("item_no")
  blockNo         Int?     @map("block_no")
  partName        String   @map("part_name")
  description     String?
  material        String?
  /// Raw source value — the live CSVs carry things like "40 NOS." Column
  /// stays "qty" (`@map`) — this is a Prisma-model-only rename, no data
  /// movement. Kept verbatim for import fidelity alongside the parsed
  /// `qtyPer`/`uom` below.
  sourceQty       String   @map("qty")
  /// Parsed out of `sourceQty` by `scripts/backfill-bom-item-qty-per.ts`
  /// (regex `/^(\d+(?:\.\d+)?)\s*(.*)$/`). Nullable — free-text source
  /// values (e.g. "As required") are left null, never guessed.
  qtyPer          Decimal? @map("qty_per") @db.Decimal(12, 3)
  uom             String?  @map("uom")
  unit            String?
  componentTypeId Int?     @map("component_type_id")
  remarks         String?
  /// Multi-level BOM tree (B2, Phase 4). Nullable/additive — every existing
  /// row's parent stays null; no hierarchy inferred from the flat CSV
  /// import, which carries no parent signal. First writer is the (later,
  /// separately-dispatched) BOM authoring UI.
  parentBomItemId Int?     @map("parent_bom_item_id")
  /// B3, Phase 4: which BomRevision this row belongs to. Nullable during
  /// migration only — scripts/backfill-bom-revision.ts sets every existing
  /// row onto its equipment's auto-created "Revision 1, RELEASED" row
  /// immediately after the column is added, since the seed data has always
  /// been the de-facto released BOM. A fresh import path setting this at
  /// write time is a later dispatch's job.
  bomRevisionId   Int?     @map("bom_revision_id")
  /// H1 job-level RLS backstop: denormalized from equipment.jobId.
  jobId           Int      @map("job_id")
  /// AUD-001: 0 is a placeholder Prisma needs to treat this field as
  /// optional in create() input. The BEFORE INSERT DB trigger
  /// (aud001_derive_tenant_id) always overwrites it from job_id before
  /// any constraint check runs — 0 is never actually persisted.
  tenantId        Int      @default(0) @map("tenant_id")

  equipment               Equipment                @relation(fields: [equipmentId], references: [id])
  componentType           ComponentTypeRef?        @relation(fields: [componentTypeId], references: [id])
  bomRevision             BomRevision?             @relation(fields: [bomRevisionId], references: [id])
  job                     Job                      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tenant                  Organization             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  procurementEvents       ProcurementEvent[]
  materialIdentifications MaterialIdentification[]
  stockLots               StockLot[]
  components              Component[]
  tests                   ItemTest[]
  parent                  BomItem?                 @relation("BomItemHierarchy", fields: [parentBomItemId], references: [id])
  children                BomItem[]                @relation("BomItemHierarchy")

  /// S21: an item number must be unique within one BOM revision. NULL
  /// `bomRevisionId` rows (pre-B3 backfill stragglers, if any) are exempt —
  /// Postgres treats NULL as distinct per row, so this can't retroactively
  /// break rows the backfill hasn't reached. Replaces the plain
  /// `@@index([bomRevisionId])` it was scoped from — this composite index
  /// already covers every query that filtered on `bomRevisionId` alone.
  @@unique([bomRevisionId, itemNo])
  @@index([equipmentId])
  @@index([componentTypeId])
  @@index([parentBomItemId])
  @@index([jobId])
  @@index([tenantId])
  @@map("bom_items")
}

/// Append-only procurement ledger (B5, Phase 4) — replaces the mutable
/// `Procurement` row-per-BomItem. "Received so far" is a sum over `RECEIPT`
/// events, never an asserted enum. `qty` is only meaningful on `RECEIPT`
/// (null for the other three types) and is itself nullable there: old
/// `PARTIALLY_RECEIVED` data never recorded a number, and backfilling one
/// would be a guess this codebase forbids — see
/// `scripts/backfill-procurement-events.ts`.
///
/// No update/delete path exists anywhere in `src/` for this model by
/// construction (service layer only ever calls `.create`) — append-only is
/// enforced at the application layer, same spirit as `AuditLog`/
/// `DomainEvent` (which are enforced at the DB grant layer instead, since
/// those two are infrastructure tables the app itself never rewrites).
model ProcurementEvent {
  id        Int                  @id @default(autoincrement())
  bomItemId Int                  @map("bom_item_id")
  type      ProcurementEventType
  qty       Decimal?             @db.Decimal(12, 3)
  /// Indent/PO number — reuses the slot `Procurement.indentNo`/`poNo` held.
  refNo     String?              @map("ref_no")
  at        DateTime             @default(now())
  /// Actor who logged this event. Not one of B10's FK-less "actor" columns —
  /// this field is created fresh in this dispatch, so it gets the `@relation`
  /// immediately instead of deferring it.
  by        Int
  /// H1 job-level RLS backstop: denormalized from bomItem.equipment.jobId.
  jobId     Int                  @map("job_id")
  /// AUD-001: 0 is a placeholder Prisma needs to treat this field as
  /// optional in create() input. The BEFORE INSERT DB trigger
  /// (aud001_derive_tenant_id) always overwrites it from job_id before
  /// any constraint check runs — 0 is never actually persisted.
  tenantId  Int                  @default(0) @map("tenant_id")

  bomItem   BomItem      @relation(fields: [bomItemId], references: [id], onDelete: Cascade)
  actor     User         @relation(fields: [by], references: [id])
  job       Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tenant    Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stockLots StockLot[]

  @@index([bomItemId])
  @@index([bomItemId, at])
  @@index([jobId])
  @@index([tenantId])
  @@map("procurement_events")
}

/// Real traceability: heat number + MTC. Replaces the misused
/// "Material Identification" CSV column, which held a sourcing type (C8).
model MaterialIdentification {
  id          Int        @id @default(autoincrement())
  bomItemId   Int        @map("bom_item_id")
  /// B8, Phase 4: nullable during transition — equipment whose `Component.unitId`
  /// is null (BOM-item-linked data with no per-serial fan-out) has no single
  /// component to attach a heat record to and stays at `bomItemId` grain; a
  /// serialised job's per-unit `Component` rows make this meaningful. Lets one
  /// heat record trace forward to the actual serial it entered, not just the
  /// BOM item shared across every unit of an equipment.
  componentId Int?       @map("component_id")
  heatNumber  String     @map("heat_number")
  mtcRef      String?    @map("mtc_ref")
  pmiResult   PmiResult?
  /// B8, Phase 4: how much of this heat went into this component — a
  /// traceability fact, distinct from `StockTxn`'s ledger-level quantity.
  qtyIssued   Decimal?   @map("qty_issued") @db.Decimal(12, 3)
  /// H1 job-level RLS backstop: denormalized from bomItem.equipment.jobId.
  jobId       Int        @map("job_id")
  /// AUD-001: 0 is a placeholder Prisma needs to treat this field as
  /// optional in create() input. The BEFORE INSERT DB trigger
  /// (aud001_derive_tenant_id) always overwrites it from job_id before
  /// any constraint check runs — 0 is never actually persisted.
  tenantId    Int        @default(0) @map("tenant_id")

  bomItem   BomItem      @relation(fields: [bomItemId], references: [id], onDelete: Cascade)
  component Component?   @relation(fields: [componentId], references: [id], onDelete: SetNull)
  job       Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tenant    Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([bomItemId])
  @@index([componentId])
  @@index([heatNumber])
  @@index([jobId])
  @@index([tenantId])
  @@map("material_identifications")
}

/// B6, Phase 4: a physical lot of stock for one BOM item — part + heat +
/// location + qty. Receipt itself IS `StockLot` creation, not a paired
/// "RECEIPT StockTxn" row: there is no meaningful "before" state for a lot
/// that didn't exist yet, so a separate receipt-txn would just duplicate what
/// the row's own existence + `qty` already says. `sourceProcurementEventId`
/// links back to the `ProcurementEvent` that caused this receipt when there
/// is one — nullable because a lot can be logged for stock already on hand
/// before this system existed (no procurement history to point at).
model StockLot {
  id                       Int      @id @default(autoincrement())
  bomItemId                Int      @map("bom_item_id")
  heatNumber               String?  @map("heat_number")
  location                 String
  qty                      Decimal  @db.Decimal(12, 3)
  /// SERVER CLOCK ONLY (invariant #1)
  receivedAt               DateTime @default(now()) @map("received_at")
  sourceProcurementEventId Int?     @map("source_procurement_event_id")
  /// H1 job-level RLS backstop: denormalized from bomItem.equipment.jobId.
  jobId                    Int      @map("job_id")
  /// AUD-001: 0 is a placeholder Prisma needs to treat this field as
  /// optional in create() input. The BEFORE INSERT DB trigger
  /// (aud001_derive_tenant_id) always overwrites it from job_id before
  /// any constraint check runs — 0 is never actually persisted.
  tenantId                 Int      @default(0) @map("tenant_id")

  bomItem                BomItem           @relation(fields: [bomItemId], references: [id], onDelete: Cascade)
  sourceProcurementEvent ProcurementEvent? @relation(fields: [sourceProcurementEventId], references: [id])
  job                    Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tenant                 Organization      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  txns                   StockTxn[]

  @@index([bomItemId])
  @@index([sourceProcurementEventId])
  @@index([jobId])
  @@index([tenantId])
  @@map("stock_lots")
}

/// B6, Phase 4: a movement against one `StockLot` — issued to a component,
/// returned, or scrapped. `by` gets its `@relation` immediately (same
/// reasoning as `ProcurementEvent.by`) rather than being left FK-less for a
/// later dispatch to fix.
model StockTxn {
  id          Int          @id @default(autoincrement())
  stockLotId  Int          @map("stock_lot_id")
  type        StockTxnType
  qty         Decimal      @db.Decimal(12, 3)
  /// SERVER CLOCK ONLY (invariant #1)
  at          DateTime     @default(now())
  by          Int
  /// Which component the issue went to — nullable (a RETURN/SCRAP need not
  /// name one, and an ISSUE against general stock may not either).
  componentId Int?         @map("component_id")
  note        String?
  /// H1 job-level RLS backstop: denormalized from stockLot.bomItem.equipment.jobId.
  jobId       Int          @map("job_id")
  /// AUD-001: 0 is a placeholder Prisma needs to treat this field as
  /// optional in create() input. The BEFORE INSERT DB trigger
  /// (aud001_derive_tenant_id) always overwrites it from job_id before
  /// any constraint check runs — 0 is never actually persisted.
  tenantId    Int          @default(0) @map("tenant_id")

  stockLot  StockLot     @relation(fields: [stockLotId], references: [id], onDelete: Cascade)
  actor     User         @relation(fields: [by], references: [id])
  component Component?   @relation(fields: [componentId], references: [id])
  job       Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tenant    Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([stockLotId])
  @@index([componentId])
  @@index([jobId])
  @@index([tenantId])
  @@map("stock_txns")
}

// ── Component route library ─────────────────────────────────────────────

model RouteTemplate {
  id              Int    @id @default(autoincrement())
  tenantId        Int    @map("tenant_id")
  componentTypeId Int    @map("component_type_id")
  /// Null = applies to every family.
  familyId        Int?   @map("family_id")
  name            String

  tenant        Organization           @relation(fields: [tenantId], references: [id])
  componentType ComponentTypeRef       @relation(fields: [componentTypeId], references: [id])
  family        ProductFamily?         @relation(fields: [familyId], references: [id])
  versions      RouteTemplateVersion[]

  @@unique([tenantId, componentTypeId, familyId])
  @@index([tenantId])
  @@index([componentTypeId])
  @@index([familyId])
  @@map("route_templates")
}

model RouteTemplateVersion {
  id           Int            @id @default(autoincrement())
  routeId      Int            @map("route_id")
  version      Int
  status       TemplateStatus @default(PUBLISHED)
  /// Human-readable route from DESPL's routing document.
  printedRoute String?        @map("printed_route")

  route      RouteTemplate @relation(fields: [routeId], references: [id], onDelete: Cascade)
  steps      RouteStep[]
  components Component[]

  @@unique([routeId, version])
  @@index([routeId])
  @@map("route_template_versions")
}

model RouteStep {
  id             Int     @id @default(autoincrement())
  routeVersionId Int     @map("route_version_id")
  seq            Int
  operationId    Int     @map("operation_id")
  printed        String?
  optional       Boolean @default(false)

  routeVersion RouteTemplateVersion @relation(fields: [routeVersionId], references: [id], onDelete: Cascade)
  operation    OperationRef         @relation(fields: [operationId], references: [id])

  @@unique([routeVersionId, seq])
  @@index([routeVersionId])
  @@index([operationId])
  @@map("route_steps")
}

/// A physical thing being made. THIS is what makes "one client wants 5
/// nozzles, another wants 8" representable: one BOM line spawns N tagged
/// component instances, each with its own ordered operation route.
model Component {
  id                 Int    @id @default(autoincrement())
  equipmentId        Int    @map("equipment_id")
  unitId             Int?   @map("unit_id")
  bomItemId          Int?   @map("bom_item_id")
  /// N1, N2, M1, Shell-1, Top Head…
  tag                String
  componentTypeId    Int    @map("component_type_id")
  routeVersionId     Int?   @map("route_version_id")
  /// F7b (Phase 1, pulled forward from Phase 4 — see
  /// docs/ADR-product-family-agnostic-platform-v1.md's schema-shape review,
  /// approved 26 Aug 2026). Self-referencing, nullable: schema shape only,
  /// no explosion/authoring logic yet. Lets a multi-piece component (e.g.
  /// SKIRT's base ring + 24 gusset plates) be recorded as real child rows
  /// instead of collapsed into one fabrication unit — the gap F4 names.
  /// Added while Component still has zero real rows so this never needs a
  /// backfill migration later.
  parentComponentId  Int?   @map("parent_component_id")
  /// B9, Phase 4: which `AssemblyDrawing` gates this component's CUTTING
  /// start. Nullable, MANUALLY set by whoever authors the component's
  /// route/BOM link — not auto-derived (the schema has no rule for e.g.
  /// "the GA drawing always gates the shell"), same precedent as
  /// `WeldJoint.componentId` being set by whoever logs the joint. A null
  /// value is a no-op (SEAM): components with no drawing link are
  /// completely unaffected by the CUTTING gate.
  governingDrawingId Int?   @map("governing_drawing_id")
  /// B9, Phase 4: which `DrawingRevision` this component was actually built
  /// to. SERVER-STAMPED (invariant #1) inside the same transaction
  /// `startComponentOperation` succeeds in for a CUTTING operation — never
  /// client-supplied.
  builtToRevisionId  Int?   @map("built_to_revision_id")
  /// H1 job-level RLS backstop: denormalized from equipment.jobId.
  jobId              Int    @map("job_id")
  /// AUD-001: 0 is a placeholder Prisma needs to treat this field as
  /// optional in create() input. The BEFORE INSERT DB trigger
  /// (aud001_derive_tenant_id) always overwrites it from job_id before
  /// any constraint check runs — 0 is never actually persisted.
  tenantId           Int    @default(0) @map("tenant_id")

  equipment               Equipment                @relation(fields: [equipmentId], references: [id])
  unit                    Unit?                    @relation(fields: [unitId], references: [id])
  bomItem                 BomItem?                 @relation(fields: [bomItemId], references: [id])
  componentType           ComponentTypeRef         @relation(fields: [componentTypeId], references: [id])
  routeVersion            RouteTemplateVersion?    @relation(fields: [routeVersionId], references: [id])
  parent                  Component?               @relation("ComponentHierarchy", fields: [parentComponentId], references: [id])
  children                Component[]              @relation("ComponentHierarchy")
  job                     Job                      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tenant                  Organization             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  operations              ComponentOperation[]
  weldJoints              WeldJoint[]
  stockTxns               StockTxn[]
  materialIdentifications MaterialIdentification[]
  governingDrawing        AssemblyDrawing?         @relation("ComponentGoverningDrawing", fields: [governingDrawingId], references: [id])
  builtToRevision         DrawingRevision?         @relation("ComponentBuiltToRevision", fields: [builtToRevisionId], references: [id])

  /// Component grain follows the serial (unitId), not the equipment — a
  /// serialised job's components carry a plain tag ("SHELL", not
  /// "SHELL-320SR01"). Equipment-grain components (unitId null, e.g.
  /// DE0463/DE0467's BOM-item-derived rows) are not uniqueness-checked by
  /// this index (Postgres treats NULL as distinct per row); DB-enforced
  /// instead by a partial unique index on (equipmentId, tag) WHERE unitId IS
  /// NULL, added by migration 20260827050000_component_equipment_grain_tag_unique.
  /// Not representable in Prisma's schema DSL (no filtered-index syntax), so
  /// it has no `@@` counterpart here — do not let a future `prisma migrate
  /// dev` diff propose dropping it as drift; that migration is authoritative.
  @@unique([unitId, tag])
  @@index([equipmentId])
  @@index([unitId])
  @@index([parentComponentId])
  @@index([bomItemId])
  @@index([componentTypeId])
  @@index([governingDrawingId])
  @@index([builtToRevisionId])
  @@index([jobId])
  @@index([tenantId])
  @@map("components")
}

/// Replaces the old ItemOperation, which had no sequence column and so could
/// not represent route order at all.
model ComponentOperation {
  id                  Int             @id @default(autoincrement())
  componentId         Int             @map("component_id")
  seq                 Int
  operationId         Int             @map("operation_id")
  sourcing            Sourcing?
  status              OperationStatus @default(NOT_STARTED)
  /// SERVER CLOCK ONLY (invariant #1)
  startedAt           DateTime?       @map("started_at")
  /// SERVER CLOCK ONLY (invariant #1)
  finishedAt          DateTime?       @map("finished_at")
  submittedBy         Int?            @map("submitted_by")
  verifiedBy          Int?            @map("verified_by")
  /// Who actually did the work (F3) — distinct from submittedBy (who
  /// clicked). Welders don't log in (see Welder's own doc comment); a
  /// non-welding operation (cutting, grinding, machining...) instead names
  /// performedByUserId. Not DB-enforced as mutually exclusive — Welder has
  /// no write path yet (F-f, blocks Phase 2's A5), so nothing can mandate
  /// either field being set in practice today.
  performedByWelderId Int?            @map("performed_by_welder_id")
  performedByUserId   Int?            @map("performed_by_user_id")
  remarks             String?
  /// F4 — multi-piece components (e.g. SKIRT's 24 gusset plates) need a
  /// count; done/not-done alone can't show "18 of 24 welded". Nullable,
  /// unconstrained: F-c (is a count required for v1?) is still open with the
  /// floor — see docs/DESPL-320-fabrication-assembly-spec.md §4.
  qtyPlanned          Int?
  qtyGood             Int?
  qtyRejected         Int?
  /// H1 job-level RLS backstop: denormalized from component.jobId.
  jobId               Int             @map("job_id")
  /// AUD-001: 0 is a placeholder Prisma needs to treat this field as
  /// optional in create() input. The BEFORE INSERT DB trigger
  /// (aud001_derive_tenant_id) always overwrites it from job_id before
  /// any constraint check runs — 0 is never actually persisted.
  tenantId            Int             @default(0) @map("tenant_id")

  component         Component                     @relation(fields: [componentId], references: [id], onDelete: Cascade)
  operation         OperationRef                  @relation(fields: [operationId], references: [id])
  performedByWelder Welder?                       @relation(fields: [performedByWelderId], references: [id])
  performedByUser   User?                         @relation(fields: [performedByUserId], references: [id])
  submitter         User?                         @relation("ComponentOperationSubmittedBy", fields: [submittedBy], references: [id])
  verifier          User?                         @relation("ComponentOperationVerifiedBy", fields: [verifiedBy], references: [id])
  job               Job                           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tenant            Organization                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rejections        ComponentOperationRejection[]
  paintRecord       PaintRecord?
  dftReadings       DftReading[]

  @@unique([componentId, seq])
  @@index([componentId])
  @@index([operationId])
  @@index([status])
  @@index([performedByWelderId])
  @@index([performedByUserId])
  @@index([jobId])
  @@index([tenantId])
  @@map("component_operations")
}

/// F5 — a fabrication rejection reason has a durable home (previously "has
/// nowhere durable to live yet" per component.service.ts's own comment on
/// reject() being omitted). Reuses DelayCategoryRef, the same taxonomy
/// DelayReason already uses for process-level delays, rather than inventing
/// a parallel one.
model ComponentOperationRejection {
  id                   Int      @id @default(autoincrement())
  componentOperationId Int      @map("component_operation_id")
  categoryId           Int      @map("category_id")
  detail               String?
  rejectedBy           Int      @map("rejected_by")
  rejectedAt           DateTime @default(now()) @map("rejected_at")
  /// H1 job-level RLS backstop: denormalized from componentOperation.jobId.
  jobId                Int      @map("job_id")
  /// AUD-001: 0 is a placeholder Prisma needs to treat this field as
  /// optional in create() input. The BEFORE INSERT DB trigger
  /// (aud001_derive_tenant_id) always overwrites it from job_id before
  /// any constraint check runs — 0 is never actually persisted.
  tenantId             Int      @default(0) @map("tenant_id")

  componentOperation ComponentOperation @relation(fields: [componentOperationId], references: [id], onDelete: Cascade)
  category           DelayCategoryRef   @relation(fields: [categoryId], references: [id])
  rejector           User               @relation(fields: [rejectedBy], references: [id])
  job                Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tenant             Organization       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ncr                Ncr?

  @@index([componentOperationId])
  @@index([categoryId])
  @@index([jobId])
  @@index([tenantId])
  @@map("component_operation_rejections")
}

/// P1 — paint tracking rides the existing PAINTING ComponentOperation grain
/// (already a per-component RouteStep per seed/component-routes.json); no
/// new grain needed.
model PaintRecord {
  id                   Int    @id @default(autoincrement())
  componentOperationId Int    @unique @map("component_operation_id")
  coatingSystem        String @map("coating_system")
  coatsPlanned         Int?   @map("coats_planned")
  /// H1 job-level RLS backstop: denormalized from componentOperation.jobId.
  jobId                Int    @map("job_id")
  /// AUD-001: 0 is a placeholder Prisma needs to treat this field as
  /// optional in create() input. The BEFORE INSERT DB trigger
  /// (aud001_derive_tenant_id) always overwrites it from job_id before
  /// any constraint check runs — 0 is never actually persisted.
  tenantId             Int    @default(0) @map("tenant_id")

  componentOperation ComponentOperation @relation(fields: [componentOperationId], references: [id], onDelete: Cascade)
  job                Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tenant             Organization       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([tenantId])
  @@map("paint_records")
}

/// `accepted` is self-attested by whoever records the reading (open
/// question flagged in the plan's cover note — no DFT spec-range table
/// exists to check against automatically; building one is out of scope
/// unless the floor confirms it's needed).
model DftReading {
  id                   Int      @id @default(autoincrement())
  componentOperationId Int      @map("component_operation_id")
  coatNumber           Int?     @map("coat_number")
  location             String?
  readingMicrons       Int      @map("reading_microns")
  accepted             Boolean
  recordedBy           Int      @map("recorded_by")
  /// SERVER CLOCK ONLY (invariant #1)
  recordedAt           DateTime @default(now()) @map("recorded_at")
  /// H1 job-level RLS backstop: denormalized from componentOperation.jobId.
  jobId                Int      @map("job_id")
  /// AUD-001: 0 is a placeholder Prisma needs to treat this field as
  /// optional in create() input. The BEFORE INSERT DB trigger
  /// (aud001_derive_tenant_id) always overwrites it from job_id before
  /// any constraint check runs — 0 is never actually persisted.
  tenantId             Int      @default(0) @map("tenant_id")

  componentOperation ComponentOperation @relation(fields: [componentOperationId], references: [id], onDelete: Cascade)
  recordedByUser     User               @relation(fields: [recordedBy], references: [id])
  job                Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tenant             Organization       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([componentOperationId])
  @@index([jobId])
  @@index([tenantId])
  @@map("dft_readings")
}

model ItemTest {
  id         Int        @id @default(autoincrement())
  bomItemId  Int        @map("bom_item_id")
  testTypeId Int        @map("test_type_id")
  startDate  DateTime?  @map("start_date")
  endDate    DateTime?  @map("end_date")
  result     TestResult @default(PENDING)
  /// H1 job-level RLS backstop: denormalized from bomItem.equipment.jobId.
  jobId      Int        @map("job_id")
  /// AUD-001: 0 is a placeholder Prisma needs to treat this field as
  /// optional in create() input. The BEFORE INSERT DB trigger
  /// (aud001_derive_tenant_id) always overwrites it from job_id before
  /// any constraint check runs — 0 is never actually persisted.
  tenantId   Int        @default(0) @map("tenant_id")

  bomItem  BomItem      @relation(fields: [bomItemId], references: [id], onDelete: Cascade)
  testType TestTypeRef  @relation(fields: [testTypeId], references: [id])
  job      Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tenant   Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([bomItemId])
  @@index([testTypeId])
  @@index([jobId])
  @@index([tenantId])
  @@map("item_tests")
}

// ── Welding module (PRD FR-W1..W5) ───────────────────────────────────────
// Purely additive per design note 30 — no changes to any existing table.
// Welder is tenant-root data (a registry spanning jobs, like Department);
// WeldJoint/WeldLog/NdtResult are child rows reachable only via jobId (a
// tenant-scoped parent) and carry no tenant_id of their own, matching every
// other job-child table in this schema (BomItem, Component, ItemTest, …).
//
// ponytail: no jobProcessId/StageSheet link on WeldJoint — FR-W2 asks for an
// operational joint/welder/NDT log, not a gated stage action, and the 36→25
// rollup has no dedicated welding stage to attach it to (welding is folded
// into the FABRICATION department across several stages). Add the link only
// if DESPL asks for per-stage weld traceability inside the gating spine.

/// FR-W1: name, employee code, active/inactive, home department. Welders do
/// not log in — logging is done BY a supervisor/QC user, ABOUT a welder.
model Welder {
  id           Int      @id @default(autoincrement())
  tenantId     Int      @map("tenant_id")
  name         String
  employeeCode String   @map("employee_code")
  active       Boolean  @default(true)
  departmentId Int?     @map("department_id")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant              Organization         @relation(fields: [tenantId], references: [id])
  department          Department?          @relation(fields: [departmentId], references: [id])
  joints              WeldJointWelder[]
  logs                WeldLog[]
  componentOperations ComponentOperation[]
  assemblySteps       AssemblyStep[]

  @@unique([tenantId, employeeCode])
  @@index([tenantId])
  @@index([departmentId])
  @@map("welders")
}

/// FR-W2: one butt-weld joint/seam, welder(s) + date + size/type. Joint
/// number is the printed weld-map id (e.g. LS-1, CS-2, N4-W1) — free text,
/// not unique, since re-numbering across jobs is a real-world fact of life.
model WeldJoint {
  id          Int      @id @default(autoincrement())
  jobId       Int      @map("job_id")
  unitId      Int?     @map("unit_id")
  jointNo     String   @map("joint_no")
  jointType   String   @map("joint_type")
  weldSize    String?  @map("weld_size")
  /// §4.7 dialog field: Welding Procedure Specification reference.
  wpsRef      String?  @map("wps_ref")
  /// Set by whoever logs the joint, not auto-derived from jointNo — DESPL-320's
  /// spec has no job-agnostic joint-number → component mapping (A3, Phase 2).
  componentId Int?     @map("component_id")
  loggedBy    Int      @map("logged_by")
  createdAt   DateTime @default(now()) @map("created_at")
  /// AUD-080: 0 is a placeholder Prisma needs to treat this field as
  /// optional in create() input. The BEFORE INSERT DB trigger
  /// (aud001_derive_tenant_id, reused as-is by AUD-080) always overwrites it from job_id before
  /// any constraint check runs — 0 is never actually persisted.
  tenantId    Int      @default(0) @map("tenant_id")

  job           Job               @relation(fields: [jobId], references: [id])
  tenant        Organization      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit          Unit?             @relation(fields: [unitId], references: [id])
  component     Component?        @relation(fields: [componentId], references: [id])
  logger        User              @relation(fields: [loggedBy], references: [id])
  welders       WeldJointWelder[]
  ndtResults    NdtResult[]
  assemblySteps AssemblyStep[]

  @@index([jobId])
  @@index([unitId])
  @@index([componentId])
  @@index([tenantId])
  @@map("weld_joints")
}

/// A joint may name more than one welder (spec: "welder(s)").
model WeldJointWelder {
  weldJointId Int @map("weld_joint_id")
  welderId    Int @map("welder_id")
  /// H1 job-level RLS backstop: denormalized from weldJoint.jobId.
  jobId       Int @map("job_id")
  /// AUD-001: 0 is a placeholder Prisma needs to treat this field as
  /// optional in create() input. The BEFORE INSERT DB trigger
  /// (aud001_derive_tenant_id) always overwrites it from job_id before
  /// any constraint check runs — 0 is never actually persisted.
  tenantId    Int @default(0) @map("tenant_id")

  weldJoint WeldJoint    @relation(fields: [weldJointId], references: [id], onDelete: Cascade)
  welder    Welder       @relation(fields: [welderId], references: [id])
  job       Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tenant    Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([weldJointId, welderId])
  @@index([welderId])
  @@index([jobId])
  @@index([tenantId])
  @@map("weld_joint_welders")
}

/// FR-W2: fillet/misc work logged as a day-total per welder (hours or a raw
/// output quantity) rather than one row per joint.
model WeldLog {
  id        Int      @id @default(autoincrement())
  welderId  Int      @map("welder_id")
  jobId     Int      @map("job_id")
  logDate   DateTime @map("log_date") @db.Date
  hours     Decimal? @db.Decimal(5, 2)
  outputQty Int?     @map("output_qty")
  note      String?
  loggedBy  Int      @map("logged_by")
  createdAt DateTime @default(now()) @map("created_at")
  /// AUD-080: 0 is a placeholder Prisma needs to treat this field as
  /// optional in create() input. The BEFORE INSERT DB trigger
  /// (aud001_derive_tenant_id, reused as-is by AUD-080) always overwrites it from job_id before
  /// any constraint check runs — 0 is never actually persisted.
  tenantId  Int      @default(0) @map("tenant_id")

  welder Welder       @relation(fields: [welderId], references: [id])
  job    Job          @relation(fields: [jobId], references: [id])
  tenant Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  logger User         @relation(fields: [loggedBy], references: [id])

  @@index([welderId])
  @@index([jobId])
  @@index([tenantId])
  @@map("weld_logs")
}

/// FR-W3: RT/UT/PT/MT result per joint, recorded by QC, attributed to the
/// joint's welder(s) → per-welder repair rate. Reuses TestTypeRef (design
/// note 4 — NDT methods are an open, tenant-scoped vocabulary, not an enum)
/// and TestResult (design note: PENDING/ACCEPT/REJECT already matches this
/// shape 1:1 — the UI humanizes REJECT as "Repair" rather than adding a
/// second enum with identical values).
model NdtResult {
  id          Int        @id @default(autoincrement())
  weldJointId Int        @map("weld_joint_id")
  testTypeId  Int        @map("test_type_id")
  result      TestResult @default(PENDING)
  recordedBy  Int?       @map("recorded_by")
  /// SERVER CLOCK ONLY (invariant #1)
  recordedAt  DateTime?  @map("recorded_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  /// H1 job-level RLS backstop: denormalized from weldJoint.jobId.
  jobId       Int        @map("job_id")
  /// AUD-001: 0 is a placeholder Prisma needs to treat this field as
  /// optional in create() input. The BEFORE INSERT DB trigger
  /// (aud001_derive_tenant_id) always overwrites it from job_id before
  /// any constraint check runs — 0 is never actually persisted.
  tenantId    Int        @default(0) @map("tenant_id")

  weldJoint WeldJoint    @relation(fields: [weldJointId], references: [id], onDelete: Cascade)
  testType  TestTypeRef  @relation(fields: [testTypeId], references: [id])
  recorder  User?        @relation(fields: [recordedBy], references: [id])
  job       Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tenant    Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([weldJointId])
  @@index([testTypeId])
  @@index([jobId])
  @@index([tenantId])
  @@map("ndt_results")
}

// ── Assembly tracking (Phase 2 — addendum §2) ────────────────────────────
// Assembly is a third grain, distinct from the 36-process spine (JobProcess)
// and component-level fabrication (ComponentOperation): it's the vessel's
// whole life from document gate to MDR (groups A–Q), not a per-component
// route. Same three-layer template/version/instance pattern as everything
// else in this schema (ProcessTemplate→JobProcess, RouteTemplate→
// ComponentOperation) so a second family's assembly sequence is data, not
// code — see docs/ADR-product-family-agnostic-platform-v1.md and §0's
// generality rule in docs/PHASE-PROMPTS.md.

enum AssemblyStepKind {
  WORK
  INSPECTION
}

model AssemblyTemplate {
  id       Int    @id @default(autoincrement())
  tenantId Int    @map("tenant_id")
  familyId Int    @map("family_id")
  name     String

  tenant   Organization              @relation(fields: [tenantId], references: [id])
  family   ProductFamily             @relation(fields: [familyId], references: [id])
  versions AssemblyTemplateVersion[]

  @@index([tenantId])
  @@index([familyId])
  @@map("assembly_templates")
}

model AssemblyTemplateVersion {
  id          Int            @id @default(autoincrement())
  templateId  Int            @map("template_id")
  version     Int
  status      TemplateStatus @default(DRAFT)
  publishedAt DateTime?      @map("published_at")
  notes       String?

  template AssemblyTemplate       @relation(fields: [templateId], references: [id])
  steps    AssemblyTemplateStep[]
  jobs     Job[]

  @@unique([templateId, version])
  @@index([templateId])
  @@map("assembly_template_versions")
}

/// One row per printed A–Q checkpoint, authored once per family from the
/// QAP (spec §2). `kind` is the QAP-conflation split (addendum §2): the same
/// sr no often contains both work and its inspection as separate printed
/// lines, and this schema keeps them as separate rows/steps, matching the
/// spec document's own row-per-checkpoint layout.
model AssemblyTemplateStep {
  id                  Int              @id @default(autoincrement())
  versionId           Int              @map("version_id")
  seq                 Int
  groupCode           String           @map("group_code")
  groupName           String           @map("group_name")
  /// Printed QAP reference, e.g. "4.5" — deliberately not unique (same
  /// discipline as QcpItem.srNo: several rows share one sr no).
  srNo                String           @map("sr_no")
  activity            String
  kind                AssemblyStepKind
  defaultDepartmentId Int              @map("default_department_id")
  /// Resolves to QcpItem.srNo at materialisation — match-by-code, never by
  /// id, the same discipline cloneQcpTemplate already uses so it survives
  /// QCP renumbering across template versions.
  qcpSrNo             String?          @map("qcp_sr_no")
  /// Printed weld-map reference ("LS-1", "CS-2", ...), set only on the six
  /// weld groups (E/G/H/J/K/L per spec §3). Not a WeldJoint FK — the actual
  /// joint doesn't exist until the floor logs it against this step.
  jointRef            String?          @map("joint_ref")
  /// Which of the 36 lead-time processes (`JobProcess.code`, as a number)
  /// this assembly step rolls up into — same mapping OperationRef carries
  /// for fabrication (Phase 3, addendum §3). Null where the step has no
  /// 1:1 spine process (author it on the template, never in code).
  leadTimeProcessSeq  Int?             @map("lead_time_process_seq")

  version           AssemblyTemplateVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  defaultDepartment Department              @relation(fields: [defaultDepartmentId], references: [id])
  steps             AssemblyStep[]

  @@unique([versionId, seq])
  @@index([versionId])
  @@index([defaultDepartmentId])
  /// S21: same hot-path join as OperationRef.leadTimeProcessSeq, for the AssemblyStep side.
  @@index([leadTimeProcessSeq])
  @@map("assembly_template_steps")
}

/// Materialised per unit from the job's pinned AssemblyTemplateVersion, the
/// same way ProcessPlan/ComponentOperation are — reuses OperationStatus and
/// F8's generic assertStateTransition (see assembly.service.ts).
model AssemblyStep {
  id                  Int             @id @default(autoincrement())
  unitId              Int             @map("unit_id")
  templateStepId      Int             @map("template_step_id")
  seq                 Int
  status              OperationStatus @default(NOT_STARTED)
  /// SERVER CLOCK ONLY (invariant #1)
  startedAt           DateTime?       @map("started_at")
  /// SERVER CLOCK ONLY (invariant #1)
  finishedAt          DateTime?       @map("finished_at")
  performedByWelderId Int?            @map("performed_by_welder_id")
  performedByUserId   Int?            @map("performed_by_user_id")
  submittedBy         Int?            @map("submitted_by")
  verifiedBy          Int?            @map("verified_by")
  /// Bound as the joint is logged (WORK weld steps only).
  weldJointId         Int?            @map("weld_joint_id")
  /// Bound at materialisation by qcpSrNo match (INSPECTION steps that map to
  /// a real QcpItem — links the hold/witness points assertNoOpenHoldPoint
  /// already enforces, no change needed there).
  qcpItemId           Int?            @map("qcp_item_id")
  remarks             String?
  /// H1 job-level RLS backstop: denormalized from unit.equipment.jobId.
  jobId               Int             @map("job_id")
  /// AUD-001: 0 is a placeholder Prisma needs to treat this field as
  /// optional in create() input. The BEFORE INSERT DB trigger
  /// (aud001_derive_tenant_id) always overwrites it from job_id before
  /// any constraint check runs — 0 is never actually persisted.
  tenantId            Int             @default(0) @map("tenant_id")

  unit              Unit                    @relation(fields: [unitId], references: [id])
  templateStep      AssemblyTemplateStep    @relation(fields: [templateStepId], references: [id])
  weldJoint         WeldJoint?              @relation(fields: [weldJointId], references: [id])
  qcpItem           QcpItem?                @relation(fields: [qcpItemId], references: [id])
  performedByWelder Welder?                 @relation(fields: [performedByWelderId], references: [id])
  performedByUser   User?                   @relation(fields: [performedByUserId], references: [id])
  submitter         User?                   @relation("AssemblyStepSubmittedBy", fields: [submittedBy], references: [id])
  verifier          User?                   @relation("AssemblyStepVerifiedBy", fields: [verifiedBy], references: [id])
  job               Job                     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tenant            Organization            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rejections        AssemblyStepRejection[]

  @@unique([unitId, seq])
  @@index([unitId])
  @@index([templateStepId])
  @@index([status])
  @@index([weldJointId])
  @@index([qcpItemId])
  @@index([performedByWelderId])
  @@index([performedByUserId])
  @@index([jobId])
  @@index([tenantId])
  @@map("assembly_steps")
}

/// Mirrors ComponentOperationRejection (F5) — same durable-reason pattern,
/// same DelayCategoryRef taxonomy, for the assembly grain's reject flow.
model AssemblyStepRejection {
  id             Int      @id @default(autoincrement())
  assemblyStepId Int      @map("assembly_step_id")
  categoryId     Int      @map("category_id")
  detail         String?
  rejectedBy     Int      @map("rejected_by")
  rejectedAt     DateTime @default(now()) @map("rejected_at")
  /// H1 job-level RLS backstop: denormalized from assemblyStep.jobId.
  jobId          Int      @map("job_id")
  /// AUD-001: 0 is a placeholder Prisma needs to treat this field as
  /// optional in create() input. The BEFORE INSERT DB trigger
  /// (aud001_derive_tenant_id) always overwrites it from job_id before
  /// any constraint check runs — 0 is never actually persisted.
  tenantId       Int      @default(0) @map("tenant_id")

  assemblyStep AssemblyStep     @relation(fields: [assemblyStepId], references: [id], onDelete: Cascade)
  category     DelayCategoryRef @relation(fields: [categoryId], references: [id])
  rejector     User             @relation(fields: [rejectedBy], references: [id])
  job          Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tenant       Organization     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ncr          Ncr?

  @@index([assemblyStepId])
  @@index([categoryId])
  @@index([jobId])
  @@index([tenantId])
  @@map("assembly_step_rejections")
}

/// N1 — layered on top of ComponentOperationRejection/AssemblyStepRejection,
/// not a replacement: the rejection row is the immutable "why reopened"
/// record (F5); Ncr is the disposition/rework workflow that follows it.
/// Exactly one of componentOperationRejectionId/assemblyStepRejectionId is
/// set — enforced by a raw CHECK constraint added in this task's migration
/// (Prisma has no native XOR-column support), plus an app-level assert in
/// ncr.service.ts (Task 2).
model Ncr {
  id                            Int             @id @default(autoincrement())
  componentOperationRejectionId Int?            @unique @map("component_operation_rejection_id")
  assemblyStepRejectionId       Int?            @unique @map("assembly_step_rejection_id")
  status                        NcrStatus       @default(OPEN)
  disposition                   NcrDisposition?
  dispositionedBy               Int?            @map("dispositioned_by")
  dispositionedAt               DateTime?       @map("dispositioned_at")
  dispositionNotes              String?         @map("disposition_notes")
  reworkOwnerId                 Int?            @map("rework_owner_id")
  reworkDueDate                 DateTime?       @map("rework_due_date")
  /// SERVER CLOCK ONLY (invariant #1) — stamped by Task 2's start/submit hooks.
  reworkStartedAt               DateTime?       @map("rework_started_at")
  /// SERVER CLOCK ONLY (invariant #1)
  reworkFinishedAt              DateTime?       @map("rework_finished_at")
  closedBy                      Int?            @map("closed_by")
  closedAt                      DateTime?       @map("closed_at")
  /// H1 job-level RLS backstop: denormalized from whichever of
  /// componentOperationRejection/assemblyStepRejection's jobId is set (XOR).
  jobId                         Int             @map("job_id")
  /// AUD-001: 0 is a placeholder Prisma needs to treat this field as
  /// optional in create() input. The BEFORE INSERT DB trigger
  /// (aud001_derive_tenant_id) always overwrites it from job_id before
  /// any constraint check runs — 0 is never actually persisted.
  tenantId                      Int             @default(0) @map("tenant_id")

  componentOperationRejection ComponentOperationRejection? @relation(fields: [componentOperationRejectionId], references: [id], onDelete: Cascade)
  assemblyStepRejection       AssemblyStepRejection?       @relation(fields: [assemblyStepRejectionId], references: [id], onDelete: Cascade)
  dispositionedByUser         User?                        @relation("NcrDispositionedBy", fields: [dispositionedBy], references: [id])
  reworkOwner                 User?                        @relation("NcrReworkOwner", fields: [reworkOwnerId], references: [id])
  closedByUser                User?                        @relation("NcrClosedBy", fields: [closedBy], references: [id])
  job                         Job                          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tenant                      Organization                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([jobId])
  @@index([tenantId])
  @@map("ncrs")
}

// ── QCP / ITP engine (dynamic parties, per-project code sets) ───────────

model QcpTemplate {
  id         Int     @id @default(autoincrement())
  /// AUD-069: RESTRICT, not the original SET NULL — deleting a job with QCP
  /// rows attached must be refused, not silently promote them into the
  /// shared library where the (fail-open, by design) job_isolation policy
  /// makes them cross-tenant readable. See qcp_items/inspection_parties/
  /// qcp_item_party_codes for the same change.
  jobId      Int?    @map("job_id")
  /// Raw label from the source document; may not resolve to a job.
  jobLabel   String  @map("job_label")
  vessel     String
  revision   Int     @default(0)
  designCode String? @map("design_code")
  /// AUD-078: NOT NULL. The BEFORE INSERT trigger (aud001_derive_tenant_id)
  /// derives this from job_id when present; for a genuine library row
  /// (jobId IS NULL) there is no job to derive from, so the app must supply
  /// a real tenantId at create time (createQcpTemplateLibrary does). The
  /// `@default(0)` placeholder only exists so Prisma treats this as
  /// optional on job-owned creates that rely on the trigger — 0 is never
  /// actually persisted there. Library templates used to leave this null
  /// and were readable/clonable by every tenant; the 3 pre-existing rows
  /// were backfilled from their creator's audit_log entry.
  tenantId   Int     @default(0) @map("tenant_id")

  job     Job?              @relation(fields: [jobId], references: [id], onDelete: Restrict)
  tenant  Organization      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parties InspectionParty[]
  items   QcpItem[]

  @@index([jobId])
  @@index([tenantId])
  @@map("qcp_templates")
}

/// Per-project rows, not columns. Real QAPs range from 2 parties
/// (DESPL + BUYER_TPI) to 3 (DESPL + BUSCI_TPI + EIL_TPIA on a heat exchanger).
model InspectionParty {
  id            Int     @id @default(autoincrement())
  qcpTemplateId Int     @map("qcp_template_id")
  code          String
  name          String?
  /// H1 job-level RLS backstop: denormalized from qcpTemplate.jobId. Stays
  /// null for library templates (qcpTemplate.jobId IS NULL) — never forced.
  /// AUD-069: RESTRICT, not the original SET NULL — see QcpTemplate.job.
  jobId         Int?    @map("job_id")
  /// AUD-078: NOT NULL, same trigger/placeholder shape as QcpTemplate.tenantId.
  tenantId      Int     @default(0) @map("tenant_id")

  qcpTemplate QcpTemplate        @relation(fields: [qcpTemplateId], references: [id], onDelete: Cascade)
  job         Job?               @relation(fields: [jobId], references: [id], onDelete: Restrict)
  tenant      Organization       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  itemCodes   QcpItemPartyCode[]

  @@unique([qcpTemplateId, code])
  @@index([qcpTemplateId])
  @@index([jobId])
  @@index([tenantId])
  @@map("inspection_parties")
}

/// `sequence` carries the ordering; `srNo` is the raw printed value and is
/// deliberately NOT unique — the real QCP has 62 items sharing 43 sr numbers,
/// and the old unique constraint forced the seed to corrupt them into
/// "4.8b"/"4.8c"/"4.8d".
model QcpItem {
  id                  Int         @id @default(autoincrement())
  qcpTemplateId       Int         @map("qcp_template_id")
  sequence            Int
  srNo                String      @map("sr_no")
  kind                QcpItemKind
  section             String?
  activity            String
  characteristic      String?
  extentOfCheck       String?     @map("extent_of_check")
  applicableDocument  String?     @map("applicable_document")
  acceptanceCriteria  String?     @map("acceptance_criteria")
  record              String?
  remarks             String?
  /// C7: for a LIBRARY item (its QcpTemplate.jobId is null) only — the raw
  /// process-code strings (e.g. ["12", "16"]) this checkpoint is meant to
  /// gate once cloned into a real job. Unused/ignored once the item belongs
  /// to a job-owned template; real linkage there is via QcpItemProcess.
  libraryProcessCodes String[]    @default([]) @map("library_process_codes")
  /// H1 job-level RLS backstop: denormalized from qcpTemplate.jobId. Stays
  /// null for library templates (qcpTemplate.jobId IS NULL) — never forced.
  /// AUD-069: RESTRICT, not the original SET NULL — see QcpTemplate.job.
  jobId               Int?        @map("job_id")
  /// AUD-078: NOT NULL, same trigger/placeholder shape as QcpTemplate.tenantId.
  tenantId            Int         @default(0) @map("tenant_id")

  qcpTemplate   QcpTemplate        @relation(fields: [qcpTemplateId], references: [id], onDelete: Cascade)
  job           Job?               @relation(fields: [jobId], references: [id], onDelete: Restrict)
  tenant        Organization       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partyCodes    QcpItemPartyCode[]
  executions    QcpExecution[]
  processLinks  QcpItemProcess[]
  assemblySteps AssemblyStep[]

  @@unique([qcpTemplateId, sequence])
  @@index([qcpTemplateId])
  @@index([jobId])
  @@index([tenantId])
  @@map("qcp_items")
}

/// Real join table replacing the unenforced Int[] crosswalk.
model QcpItemProcess {
  qcpItemId    Int @map("qcp_item_id")
  jobProcessId Int @map("job_process_id")
  /// H1 job-level RLS backstop: denormalized from qcpItem.jobId OR
  /// jobProcess.jobId (whichever is non-null — see the plan's dual-path note).
  jobId        Int @map("job_id")
  /// AUD-001: 0 is a placeholder Prisma needs to treat this field as
  /// optional in create() input. The BEFORE INSERT DB trigger
  /// (aud001_derive_tenant_id) always overwrites it from job_id before
  /// any constraint check runs — 0 is never actually persisted.
  tenantId     Int @default(0) @map("tenant_id")

  qcpItem    QcpItem      @relation(fields: [qcpItemId], references: [id], onDelete: Cascade)
  jobProcess JobProcess   @relation(fields: [jobProcessId], references: [id], onDelete: Cascade)
  job        Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tenant     Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([qcpItemId, jobProcessId])
  @@index([jobProcessId])
  @@index([jobId])
  @@index([tenantId])
  @@map("qcp_item_processes")
}

model QcpItemPartyCode {
  qcpItemId         Int  @map("qcp_item_id")
  inspectionPartyId Int  @map("inspection_party_id")
  qcpCodeId         Int  @map("qcp_code_id")
  /// H1 job-level RLS backstop: denormalized from qcpItem.jobId. Nullable —
  /// library rows (parent QcpItem.jobId IS NULL) have no job, same as QcpItem
  /// and InspectionParty.
  /// AUD-069: RESTRICT, not the original SET NULL — see QcpTemplate.job.
  jobId             Int? @map("job_id")
  /// AUD-078: NOT NULL, same trigger/placeholder shape as QcpTemplate.tenantId.
  tenantId          Int  @default(0) @map("tenant_id")

  qcpItem         QcpItem         @relation(fields: [qcpItemId], references: [id], onDelete: Cascade)
  inspectionParty InspectionParty @relation(fields: [inspectionPartyId], references: [id], onDelete: Cascade)
  qcpCode         QcpCodeRef      @relation(fields: [qcpCodeId], references: [id])
  job             Job?            @relation(fields: [jobId], references: [id], onDelete: Restrict)
  tenant          Organization    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([qcpItemId, inspectionPartyId])
  @@index([inspectionPartyId])
  @@index([qcpCodeId])
  @@index([jobId])
  @@index([tenantId])
  @@map("qcp_item_party_codes")
}

/// `attemptNo` makes re-inspection representable. The old unique constraint on
/// (qcpItem, unit) meant a rejected-then-re-inspected checkpoint could not be
/// recorded at all, which broke PRD FR-Q2.
model QcpExecution {
  id                Int                @id @default(autoincrement())
  qcpItemId         Int                @map("qcp_item_id")
  unitId            Int                @map("unit_id")
  attemptNo         Int                @default(1) @map("attempt_no")
  result            QcpExecutionResult @default(PENDING)
  callGivenOn       DateTime?          @map("call_given_on")
  /// SERVER CLOCK ONLY (invariant #1)
  callAttendedOn    DateTime?          @map("call_attended_on")
  clearedBy         Int?               @map("cleared_by")
  clearedByPartyRef String?            @map("cleared_by_party_ref")
  waiverApprovedBy  Int?               @map("waiver_approved_by")
  remarks           String?
  /// SERVER CLOCK ONLY (invariant #1)
  recordedAt        DateTime           @default(now()) @map("recorded_at")
  /// H1 job-level RLS backstop: denormalized from unit.equipment.jobId
  /// (cross-checked against qcpItem.jobId at backfill time when the item is
  /// job-scoped — see the plan's dual-path note).
  jobId             Int                @map("job_id")
  /// AUD-001: 0 is a placeholder Prisma needs to treat this field as
  /// optional in create() input. The BEFORE INSERT DB trigger
  /// (aud001_derive_tenant_id) always overwrites it from job_id before
  /// any constraint check runs — 0 is never actually persisted.
  tenantId          Int                @default(0) @map("tenant_id")

  qcpItem QcpItem      @relation(fields: [qcpItemId], references: [id], onDelete: Cascade)
  unit    Unit         @relation(fields: [unitId], references: [id])
  clearer User?        @relation("QcpExecutionClearedBy", fields: [clearedBy], references: [id])
  waiver  User?        @relation("QcpExecutionWaiverApprovedBy", fields: [waiverApprovedBy], references: [id])
  job     Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tenant  Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([qcpItemId, unitId, attemptNo])
  @@index([qcpItemId])
  @@index([unitId])
  @@index([result])
  @@index([jobId])
  @@index([tenantId])
  @@map("qcp_executions")
}

// ── Drawings ────────────────────────────────────────────────────────────

model AssemblyDrawing {
  id            Int     @id @default(autoincrement())
  jobId         Int     @map("job_id")
  drawingTypeId Int     @map("drawing_type_id")
  drawingNo     String? @map("drawing_no")
  remarks       String?
  /// AUD-080: 0 is a placeholder Prisma needs to treat this field as
  /// optional in create() input. The BEFORE INSERT DB trigger
  /// (aud001_derive_tenant_id, reused as-is by AUD-080) always overwrites it from job_id before
  /// any constraint check runs — 0 is never actually persisted.
  tenantId      Int     @default(0) @map("tenant_id")

  job                 Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tenant              Organization      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  drawingType         DrawingTypeRef    @relation(fields: [drawingTypeId], references: [id])
  revisions           DrawingRevision[]
  governingComponents Component[]       @relation("ComponentGoverningDrawing")

  @@index([jobId])
  @@index([drawingTypeId])
  @@index([tenantId])
  @@map("assembly_drawings")
}

/// B9, Phase 4: revisionNo/status/dates used to be flat, overwritten fields
/// on `AssemblyDrawing` — mutating them in place destroyed the prior
/// revision, violating invariant #9 (versioned things are never edited in
/// place). Each revision is now its own row; issuing Rev B flips a prior
/// RELEASED revision to SUPERSEDED (drawing.service.ts's
/// `createDrawingRevision`) rather than overwriting it. The current
/// revision for a drawing is the one with the highest `revisionNo`.
model DrawingRevision {
  id                Int           @id @default(autoincrement())
  assemblyDrawingId Int           @map("assembly_drawing_id")
  revisionNo        Int           @map("revision_no")
  status            DrawingStatus @default(DRAFT)
  /// Task review Important: AssemblyDrawing's old approved_date/revised_date
  /// moved here rather than being dropped — the brief's own wording ("moved
  /// onto the revision rows") plus real seed data (e.g. DE0463-001) carrying
  /// both. Set at seed/authoring time; not stamped by the CUTTING gate the
  /// way releasedAt effectively is via createDrawingRevision.
  approvedAt        DateTime?     @map("approved_at")
  revisedAt         DateTime?     @map("revised_at")
  releasedAt        DateTime?     @map("released_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  /// H1 job-level RLS backstop: denormalized from assemblyDrawing.jobId.
  jobId             Int           @map("job_id")
  /// AUD-001: 0 is a placeholder Prisma needs to treat this field as
  /// optional in create() input. The BEFORE INSERT DB trigger
  /// (aud001_derive_tenant_id) always overwrites it from job_id before
  /// any constraint check runs — 0 is never actually persisted.
  tenantId          Int           @default(0) @map("tenant_id")

  assemblyDrawing   AssemblyDrawing @relation(fields: [assemblyDrawingId], references: [id], onDelete: Cascade)
  job               Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tenant            Organization    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  builtByComponents Component[]     @relation("ComponentBuiltToRevision")

  @@unique([assemblyDrawingId, revisionNo])
  @@index([assemblyDrawingId])
  @@index([jobId])
  @@index([tenantId])
  @@map("drawing_revisions")
}

/// Staged/partial dispatch dates for a single job. Found on DE0463 (QTY-40
/// NOS.): 28.07 / 10.08 / 20.08 / 30.08.2026, printed with no column header
/// and no per-batch quantity in the source tracker — `qty` stays nullable
/// rather than guessing an even split. `Job.deliveryDate` is unchanged and
/// still holds the tracker's own "Dispatch Date" field (the first batch);
/// this table is purely additive.
model DispatchBatch {
  id                 Int       @id @default(autoincrement())
  jobId              Int       @map("job_id")
  seq                Int
  plannedDate        DateTime  @map("planned_date")
  qty                Int?
  remarks            String?
  dispatchNoteNo     String?   @map("dispatch_note_no")
  gatePassNo         String?   @map("gate_pass_no")
  vehicleNo          String?   @map("vehicle_no")
  lrNo               String?   @map("lr_no")
  releaseApprovedBy  Int?      @map("release_approved_by")
  releaseApprovedAt  DateTime? @map("release_approved_at")
  /// SERVER CLOCK ONLY (invariant #1)
  actualDispatchDate DateTime? @map("actual_dispatch_date")
  /// AUD-080: 0 is a placeholder Prisma needs to treat this field as
  /// optional in create() input. The BEFORE INSERT DB trigger
  /// (aud001_derive_tenant_id, reused as-is by AUD-080) always overwrites it from job_id before
  /// any constraint check runs — 0 is never actually persisted.
  tenantId           Int       @default(0) @map("tenant_id")

  job                   Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tenant                Organization        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  releaseApprovedByUser User?               @relation("DispatchBatchReleaseApprovedBy", fields: [releaseApprovedBy], references: [id])
  dispatchBatchUnits    DispatchBatchUnit[]

  @@unique([jobId, seq])
  @@index([jobId])
  @@index([tenantId])
  @@map("dispatch_batches")
}

model DispatchBatchUnit {
  id              Int @id @default(autoincrement())
  dispatchBatchId Int @map("dispatch_batch_id")
  unitId          Int @map("unit_id")
  /// H1 job-level RLS backstop: denormalized from dispatchBatch.jobId.
  jobId           Int @map("job_id")
  /// AUD-001: 0 is a placeholder Prisma needs to treat this field as
  /// optional in create() input. The BEFORE INSERT DB trigger
  /// (aud001_derive_tenant_id) always overwrites it from job_id before
  /// any constraint check runs — 0 is never actually persisted.
  tenantId        Int @default(0) @map("tenant_id")

  dispatchBatch DispatchBatch @relation(fields: [dispatchBatchId], references: [id], onDelete: Cascade)
  unit          Unit          @relation(fields: [unitId], references: [id])
  job           Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tenant        Organization  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([dispatchBatchId, unitId])
  @@index([dispatchBatchId])
  @@index([jobId])
  @@index([tenantId])
  @@map("dispatch_batch_units")
}

