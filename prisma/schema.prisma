// ── Client portal ───────────────────────────────────────────────────────

/// What each client may see, per contract. Every flag is checked server-side.
model ClientVisibilityPolicy {
  clientId         Int             @id @map("client_id")
  showProgress     Boolean         @default(true) @map("show_progress")
  showStageStatus  Boolean         @default(true) @map("show_stage_status")
  showDates        Boolean         @default(true) @map("show_dates")
  showQcp          Boolean         @default(true) @map("show_qcp")
  cadence          SnapshotCadence @default(WEEKLY)
  requiresApproval Boolean         @default(true) @map("requires_approval")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("client_visibility_policies")
}

enum ProgressSnapshotStatus {
  PUBLISHED
  VERIFIED
  REJECTED
}

/// DAILY / WEEKLY cadences share one code path. Doubles as the internal
/// dashboard rollup, so 15M rows collapse to ~50k here.
///
/// Review workflow (2026-08-19 client-portal-daily-updates spec): a row is
/// created PUBLISHED by Production Head each evening, and only the client
/// read query (loadClientPortalView) selects VERIFIED rows — a PUBLISHED
/// row is a draft under review, never client-visible. Once VERIFIED a row
/// is frozen forever (invariant #6); REJECTED flips back to PUBLISHED on
/// the next publish for the same day, never mutated after that.
model ProgressSnapshot {
  id              Int                    @id @default(autoincrement())
  tenantId        Int                    @map("tenant_id")
  jobId           Int                    @map("job_id")
  equipmentId     Int?                   @map("equipment_id")
  unitId          Int?                   @map("unit_id")
  asOf            DateTime               @map("as_of")
  overallPct      Int                    @map("overall_pct")
  /// Per-process/stage detail, plus forecast dates and current stage.
  detail          Json?
  status          ProgressSnapshotStatus @default(PUBLISHED)
  publishedBy     Int?                   @map("published_by")
  publishedAt     DateTime?              @map("published_at")
  verifiedBy      Int?                   @map("verified_by")
  verifiedAt      DateTime?              @map("verified_at")
  rejectionReason String?                @map("rejection_reason")

  tenant    Organization @relation(fields: [tenantId], references: [id])
  job       Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  equipment Equipment?   @relation(fields: [equipmentId], references: [id])
  unit      Unit?        @relation(fields: [unitId], references: [id])
  publisher User?        @relation("ProgressSnapshotPublishedBy", fields: [publishedBy], references: [id])
  verifier  User?        @relation("ProgressSnapshotVerifiedBy", fields: [verifiedBy], references: [id])

  // Postgres treats NULL as distinct in a unique index, so this constraint gives no
  // duplicate protection when unitId is null (equipment/job-grain rollups) — not
  // exercised by this feature (publish always passes a real unitId), but worth
  // flagging for whoever adds equipment-level rollups later.
  @@unique([jobId, unitId, asOf])
  @@index([tenantId])
  @@index([jobId, asOf])
  @@index([equipmentId])
  @@index([unitId])
  @@map("progress_snapshots")
}

// ── Audit and events ────────────────────────────────────────────────────

/// Append-only (invariant #5). The app DB role has no UPDATE/DELETE grant —
/// enforced by the REVOKE in the migration against the `despl_app` role, not
/// against PUBLIC (a superuser bypasses PUBLIC grants entirely).
///
/// ponytail: plain table, not partitioned. At ~10M rows/year a well-indexed
/// table is fine; convert to PARTITION BY RANGE(at) when it passes ~20M rows,
/// which is cheap to do while the data is still small and by which point real
/// query patterns will be known.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  tenantId   Int      @map("tenant_id")
  actorId    Int?     @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  at         DateTime @default(now())

  @@index([tenantId, entityType, entityId, at])
  @@index([tenantId, actorId, at])
  @@index([tenantId, at])
  @@map("audit_log")
}

/// Append-only domain event stream. Needed for audit reconstruction today and
/// it is what the AI agent layer will read later.
model DomainEvent {
  id            BigInt   @id @default(autoincrement())
  tenantId      Int      @map("tenant_id")
  aggregateType String   @map("aggregate_type")
  aggregateId   String   @map("aggregate_id")
  type          String
  payload       Json
  actorId       Int?     @map("actor_id")
  at            DateTime @default(now())

  @@index([tenantId, aggregateType, aggregateId, at])
  @@index([tenantId, type, at])
  @@map("domain_events")
}
