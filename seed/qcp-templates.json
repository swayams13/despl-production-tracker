        ],
        "source": "docx T9"
      },
      {
        "job": "Heat Exchanger",
        "parties": [
          "DESPL",
          "BUSCI_TPI",
          "EIL_TPIA"
        ],
        "source": "docx T10",
        "note": "THREE parties - drives the dynamic model"
      }
    ],
    "codes": {
      "P": {
        "label": "Perform",
        "blocksCompletion": false,
        "requiresCall": false,
        "desc": "Party performs the activity and records it."
      },
      "W": {
        "label": "Witness",
        "blocksCompletion": false,
        "requiresCall": true,
        "waivable": true,
        "desc": "Party must be invited. Work may proceed if the party does not attend after notice, but the waiver needs Production Head approval and is audited."
      },
      "H": {
        "label": "Hold",
        "blocksCompletion": true,
        "requiresCall": true,
        "waivable": false,
        "desc": "Work CANNOT proceed past this point until the party clears it. Hard block."
      },
      "R": {
        "label": "Review",
        "blocksCompletion": false,
        "requiresCall": false,
        "desc": "Document review only; no physical attendance."
      },
      "RW": {
        "label": "Review + Witness",
        "blocksCompletion": false,
        "requiresCall": true,
        "waivable": true,
        "TODO": "CONFIRM WITH QC: treat as W for blocking purposes? Appears in the heat exchanger and Ammonia Vaporizer QAPs."
      },
      "R&A": {
        "label": "Review & Approve",
        "blocksCompletion": true,
        "requiresCall": false,
        "TODO": "CONFIRM WITH QC: assumed blocking because approval is required before proceeding. Appears in the EIL/TPIA QAP."
      }
    },
    "callTracking": {
      "fields": [
        "inspectionCallGivenOn",
        "inspectionCallAttendedOn"
      ],
      "note": "Present in QCP DESPL-320. QC records these on the TPI's behalf in v1 (TPI login is Phase 2)."
    }
  },
