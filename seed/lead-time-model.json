  "schedulingModel": {
    "approach": "TWO_LAYER",
    "layer1_envelope": {
      "name": "Printed cumulative envelope (authoritative)",
      "use": "Tentative timeline shown on tender/RFQ upload. Reproduces DESPL's own ~17-week figure exactly.",
      "rule": "planned_finish[i] = project_start + envelope.finishBy*Days ; planned_start[i] = planned_finish[i] - duration[i]"
    },
    "layer2_cpm": {
      "name": "CPM DAG with fitted lags",
      "use": "Live replanning when actuals slip, critical-path and float computation, gating enforcement.",
      "rule": "Edges carry lagDays fitted from the printed table. Negative lag = legitimate concurrent work (start-to-start overlap), not an error.",
      "seededToMatch": "layer1_envelope"
    },
    "findings": [
      "A strict finish-to-start chain yields 11.6-24 weeks and does NOT reproduce the printed ~17 weeks.",
      "21 of 36 processes have a negative gap after their predecessor => concurrent fabrication is assumed by the table.",
      "The printed cumulative column is rounded to whole weeks; overlaps of 1-5 days are largely rounding artifacts, larger ones are real concurrency.",
      "Therefore the envelope is treated as ground truth and the DAG lags are FITTED to it rather than assumed."
    ],
    "openQuestionsForSJ": [
      "Are the printed 'Days' working days or calendar days? Holiday calendar needed.",
      "Confirm the concurrency this implies: e.g. nozzle fabrication (P19) running while shell welding/NDE (P16/P17) is still open.",
      "Confirm procurement start points: plates after design calc (P3), pipes and bought-out after drawings (P4).",
      "The 17-week total is for a single equipment. Does it hold for 40 units (DE0463) or 5 units across 3 equipments (DE0467)?"
    ]
  }
