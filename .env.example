# Application runtime — MUST be a non-owner role (e.g. despl_web).
# Tenant row-level security and the append-only audit REVOKE only bite for a
# non-superuser. Pointing this at `postgres` silently disables both.
DATABASE_URL="postgresql://despl_web:CHANGE_ME@localhost:5432/despl"

# Migrations and prisma/seed.ts — the table owner, which RLS does not constrain.
DIRECT_URL="postgresql://postgres:CHANGE_ME@localhost:5432/despl"

# Session cookie signing key. Generate with: openssl rand -hex 32
AUTH_SECRET="CHANGE_ME_min_32_chars"

# Optional: password used for seeded accounts. Defaults to a well-known dev
# value and must be set for any shared environment.
# SEED_PASSWORD=

# Shared secret the /api/cron/* routes require via `Authorization: Bearer
# <value>`. Generate with: openssl rand -hex 32
# CRON_SECRET=

# Morning digest email (Lean Core L2.11), sent by /api/cron/digest at 08:30 IST.
# Unset SMTP_HOST or SMTP_FROM = no email is sent (the in-app digest still is).
# SMTP_PORT defaults to 587; 465 uses implicit TLS. SMTP_USER / SMTP_PASS are
# optional (an internal relay may take none). APP_URL is the "Open dashboard" link.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="DESPL Tracker <digest@despl.in>"
# APP_URL=https://tracker.despl.in

# Login throttle (AUD-109): how many of OUR proxies append to x-forwarded-for.
# The client address is the entry this many places from the right, so entries a
# caller writes itself are ignored. Must equal the number of proxies in front of
# the app (Railway edge = 1; on-prem Caddy alone = 1, Caddy behind another
# proxy = 2). Caddy must APPEND to x-forwarded-for (its default), not replace
# it with something else. Too low trusts a proxy address; too high reads a
# caller-written entry. Default 1. x-real-ip is never read.
# TRUSTED_PROXY_HOPS=1
