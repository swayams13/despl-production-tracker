# Application runtime — MUST be a non-owner role (e.g. despl_web).
# Tenant row-level security and the append-only audit REVOKE only bite for a
# non-superuser. Pointing this at `postgres` silently disables both.
DATABASE_URL="postgresql://despl_web:CHANGE_ME@localhost:5432/despl"

# Migrations and prisma/seed.ts — the table owner, which RLS does not constrain.
DIRECT_URL="postgresql://postgres:CHANGE_ME@localhost:5432/despl"

# Session cookie signing key. Generate with: openssl rand -hex 32
AUTH_SECRET="CHANGE_ME_min_32_chars"

# Optional: password used for seeded accounts. Defaults to a well-known dev
# value and must be set for any shared environment.
# SEED_PASSWORD=

# Shared secret the /api/cron/* routes require via `Authorization: Bearer
# <value>`. Generate with: openssl rand -hex 32
# CRON_SECRET=
