# Template for .env.test — the environment `pnpm test:db` sources.
#
#   cp .env.test.example .env.test    # then fill in the two CHANGE_ME values
#
# .env.test itself is gitignored. Never put a real credential in THIS file.
#
# Roughly 60% of the suite is DB-gated and skips silently without this file:
# `pnpm test` runs pure tests only, `pnpm test:db` sources .env.test and sets
# RUN_DB_TESTS=1. The values below mirror .github/workflows/ci.yml's `env:`
# block, which is the authoritative version of this setup — CI builds the same
# two-role database from scratch on every PR.
#
# ── The database MUST be despl_test ───────────────────────────────────────────
# Never point RUN_DB_TESTS at despl_demo. DB-gated tests create throwaway
# Organization rows and never clean them up (deliberately — the fixtures are
# meant to persist between local runs), and several mutate the seeded DESPL-320
# fixtures. despl_demo is the live database shown to company management.
#
# First-time setup, mirroring the CI steps:
#   createdb despl_test
#   psql despl_test -c "CREATE ROLE despl_web LOGIN PASSWORD '<pick-one>';"
#   DIRECT_URL=... pnpm exec prisma migrate deploy
#   psql despl_test -v despl_web_password=<same-one> -f scripts/provision-db-role.sql
#   pnpm db:seed && pnpm db:bootstrap
#   pnpm db:seed:despl320-components
#   pnpm db:seed:despl320-bom
#   pnpm db:seed:despl320-assembly-steps

# Application runtime role — MUST be the non-owner despl_web, exactly as in
# production. Tenant RLS and the append-only audit REVOKE only bite for a
# non-superuser, so pointing this at the owner would make the RLS and audit
# tests pass against protections that were never actually enforced.
#
# connection_limit is not optional tuning: vitest runs DB-gated files with
# worker threads, and Prisma's default pool (cpus*2+1) per worker blows past
# Postgres's max_connections (100). Same caps CI uses.
DATABASE_URL="postgresql://despl_web:CHANGE_ME@localhost:5432/despl_test?connection_limit=10"

# Table owner — used by `prisma migrate deploy`, `prisma/seed.ts` and
# scripts/provision-db-role.sql. RLS does not constrain this role.
DIRECT_URL="postgresql://postgres:CHANGE_ME@localhost:5432/despl_test?connection_limit=3"

# Session cookie signing key. Any throwaway value of at least 32 characters —
# this one signs nothing outside your machine. Generate with:
#   openssl rand -hex 32
AUTH_SECRET="test_only_secret_min_32_chars_0000000000"

# Optional: password for seeded accounts. Defaults to the well-known dev value
# `despl-dev-only` when unset, which is what the e2e login fixtures expect.
# SEED_PASSWORD=

# Shared secret for /api/cron/* — any throwaway value works locally, this
# signs nothing outside your machine.
CRON_SECRET="test_only_cron_secret"
